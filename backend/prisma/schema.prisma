  @@index([bookingId])
  @@schema("booking")
}

/// Passenger создаётся для конкретного Booking на основании подтверждённых
/// данных OrderTraveler. Passenger НЕ заменяет OrderTraveler.
model Passenger {
  id             String    @id @default(uuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  birthDate      DateTime?
  citizenship    String?
  gender         String?
  passportNumber String?
  passportExpiry DateTime?

  @@index([bookingId])
  @@schema("booking")
}

/// Журнал аудита Booking (audit by default).
model BookingHistory {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  action    String
  from      String?
  to        String?
  fields    Json?
  actorId   String?
  actorName String?
  comment   String?
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@schema("booking")
}

// ─────────────────────────── communication.* ────────────────────────────────
// Canonical cross-domain Communication model (Step 1.16, ADR-0011).
// ЕДИНСТВЕННЫЙ владелец: communication.* (новый минимальный bounded context).
// НЕ владеет Order/Booking/CRM/Support lifecycle; не event bus; не AuditLog;
// не behavioral event store (§3). Ссылки на другие домены — ТОЛЬКО typed
// context references (contextType+contextId), БЕЗ cross-schema FK (ADR-0001),
// БЕЗ raw Prisma snapshot (§10/§22).

enum CommunicationType {
  /// Обычное сообщение (например, зафиксированная переписка/звонок).
  MESSAGE
  /// Внутренняя заметка персонала (НИКОГДА не отдаётся BUYER/PARTNER, §36).
  NOTE

  @@schema("communication")
}

/// Канал описывает транспорт/поверхность, а НЕ business context (§7).
/// EMAIL/PHONE/WHATSAPP НЕ объявляются, пока TravelHub реально не отправляет/
/// не принимает их (без имитации интеграций).
enum CommunicationChannel {
  PLATFORM

  @@schema("communication")
}

/// Направление (§8). Для platform-переписки между сторонами может
/// понадобиться participant-based semantics — в foundation только INBOUND/
/// OUTBOUND/INTERNAL по фактическим use-cases (запись факта коммуникации).
enum CommunicationDirection {
  INBOUND
  OUTBOUND
  /// Внутренняя заметка/действие без внешней стороны.
  INTERNAL

  @@schema("communication")
}

/// Lifecycle самой Communication (§9), НЕ Order/Booking/Lead/Support status.
/// READ/DELIVERED не создаются (нет фактических receipts, §43).
/// ARCHIVED — RESERVED state (ADR-0011 Amendment §5): producer/endpoint пока
/// отсутствуют (archive — future retention/privacy flow); client forged status
/// заблокирован (forbidden key).
enum CommunicationStatus {
  ACTIVE
  ARCHIVED

  @@schema("communication")
}

/// Canonical typed context reference (§10): один primary context на
/// Communication. SUPPORT отложен — Support domain ещё не реализован (§30),
/// extension-ready без симуляции Ticket/SLA.
/// BUYER_REQUEST — Step 2.2E pre-sale conversation context (сообщения
/// CommunicationThread, владелец reverse.BuyerRequest, НЕ переобъявляет его).
enum CommunicationContextType {
  CUSTOMER
  PARTNER
  ORDER
  BOOKING
  BUYER_REQUEST

  @@schema("communication")
}

/// Минимальный typed participant contract (§12): ТОЛЬКО реально поддерживаемые
/// identities (USER/CUSTOMER/PARTNER/SYSTEM) + canonical ID. Не копирует raw
/// User/CRM entity (§22).
enum CommunicationParticipantType {
  USER
  CUSTOMER
  PARTNER
  SYSTEM

  @@schema("communication")
}

/// Каноническая Communication (CML-*): единый факт коммуникации, способный
/// связывать cross-domain business contexts без владения ими.
/// Каноническая Communication (CML-*): единый факт коммуникации, способный
/// связывать cross-domain business contexts без владения ими.
model Communication {
  id   String @id @default(uuid())
  code String @unique // CML-00000001 — immutable, server-generated (§4)

  type      CommunicationType
  channel   CommunicationChannel  @default(PLATFORM)
  direction CommunicationDirection
  status    CommunicationStatus   @default(ACTIVE)

  /// Опциональный заголовок (≤200).
  subject String?
  /// Plain text (1..4000), БЕЗ arbitrary HTML; XSS-safe; Unicode RU/AZ/EN (§14).
  body String

  /// Canonical typed context reference (БЕЗ FK). NULL только если контекст
  /// не определён — по факту create всегда передаёт контекст (§10).
  contextType CommunicationContextType?
  contextId   String?

  /// Step 2.2E: ссылка на pre-sale conversation (communication.CommunicationThread).
  /// NULL — НЕ-пресейл Communication (CUSTOMER/PARTNER/ORDER/BOOKING контексты).
  /// Сообщения потока имеют contextType=BUYER_REQUEST + contextId=buyerRequestId
  /// (тот же business context, что у потока) + threadId (изоляция per-seller).
  threadId String?
  thread   CommunicationThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  /// Actor = кто совершил system action (§13) — canonical security.User id.
  /// НЕ путать с sender/recipient (иногда совпадают, но это не правило).
  actorUserId String?

  /// Typed participants (§12/§13): canonical ID + тип, без raw snapshot.
  senderType    CommunicationParticipantType?
  senderId      String?
  recipientType CommunicationParticipantType?
  recipientId   String?

  /// Честное время факта (§16/§17): server-side UTC. Для server-created
  /// PLATFORM record = createdAt (атомарно с фактом). Client-supplied
  /// occurredAt НЕ принимается (нет trust policy).
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  /// Row-level change tracking (например, archive). НИКОГДА не milestone
  /// (sent/read/delivered time) — §16/§58.
  updatedAt DateTime @updatedAt

  /// Step 1.15 correlation — диагностическая reference, НЕ competing tracing
  /// model (§18): requestId + correlationId из активного request context.
  requestId    String?
  correlationId String?

  @@index([contextType, contextId])
  @@index([occurredAt])
  @@index([direction, status])
  @@index([threadId])
  @@schema("communication")
}

/// Pre-sale conversation (Step 2.2E, communication.*, ADR-0011) — изолированная
/// переписка Buyer↔Seller по каноническому reverse-контексту
/// `BuyerRequest + Buyer + Seller [+ Proposal]`. Владелец — communication.*
/// (room lifecycle, membership, messages); reverse.* остаётся владельцем
/// BuyerRequest/Distribution/SellerProposal (ADR-0012).
///
/// Инварианты:
///  - РОВНО один активный канонический пресейл-разговор на
///    (buyerRequestId, sellerPartnerId) — DB unique (get-or-create, retry-safe);
///  - membership НЕ таблица: ровно 2 участника — server-derived колонки
///    buyerCustomerId (из BuyerRequest.buyerId) и sellerPartnerId (из
///    BuyerRequestDistribution.sellerId). Клиент НЕ передаёт членов/владельцев;
///    generic add/remove-member API отсутствует (нет группы, §22/§23);
///  - proposalId — опциональный trusted ref на reverse.SellerProposal
///    (валидирован: тот же request + тот же seller; auto-attach при open,
///    если Proposal уже существует); Proposal НЕ становится владельцем
///    контекста и НЕ мутируется через чат;
///  - сообщения — строки communication.Communication (CML-*) с threadId;
///  - liveness определяется ЖИВЫМ reverse.BuyerRequest.status (re-read при
///    open/send, §31): CANCELLED блокирует новые сообщения, история durable;
///  - cross-Seller изоляция: отдельный thread на каждого Seller; Seller A
///    не видит/не пишет в thread Seller B; Buyer общается с каждым отдельно;
///  - создание потока/отправка НЕ создаёт Lead/Opportunity/Quote/Sale/Order/
///    Booking/Product/Payment (zero Sales fan-out, §38); события НЕ эмитятся
///    (конвенция ADR-0011 §19); аудит — security.AuditLog без body.
model CommunicationThread {
  id   String @id @default(uuid())
  /// Канонический код потока: CML-* (тот же префикс/счётчик, что сообщения,
  /// 2.2E §18 — никакого нового ID-домена). immutable, server-generated.
  code String @unique

  /// reverse.BuyerRequest ref (БЕЗ FK, ADR-0001). Server-derived из client
  /// входного buyerRequestId (open-команда), НИКОГДА не подменяется клиентом.
  buyerRequestId String
  /// crm.Customer ref — server-derived из BuyerRequest.buyerId (member 1).
  buyerCustomerId String
  /// crm.Partner ref — server-derived из BuyerRequestDistribution.sellerId
  /// (member 2; Buyer-у — через publicId SELL-*, сервер резолвит partnerId).
  sellerPartnerId String
  /// reverse.SellerProposal ref (trusted, optional; тот же request+seller).
  proposalId String?

  /// Row-level version (зарезервирован; мутации потоков в 2.2E отсутствуют).
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Communication[]

  /// ЕДИНЫЙ канонический разговор на (request, seller) — DB-level idempotency
  /// (retry/concurrent open → один поток, §19/§21/§32).
  @@unique([buyerRequestId, sellerPartnerId])
  @@index([buyerCustomerId])
  @@index([sellerPartnerId])
  @@schema("communication")
}

// ─────────────────────────────── security.* ────────────────────────────────
// Auth + RBAC (Phase 2, Baseline 1.3): канонические роли ADMIN/DIRECTOR/FINANCE/
// MARKETER/ANALYST/MODERATOR/SALES_MANAGER/OPERATOR/PARTNER/BUYER.
// Пользователь имеет ОДНУ роль; права роли — granular permissions (не domain:write).

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@schema("security")
}

/// Тип заявителя Partner onboarding (Step 1.10): физлицо или юрлицо.
enum ApplicantType {
  INDIVIDUAL
  COMPANY

  @@schema("security")
}

/// Lifecycle PartnerApplication (Step 1.10 §5). Backend-коды стабильны,
/// UI-лейблы локализуются (RU/AZ/EN).
enum PartnerApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED

  @@schema("security")
}

/// Пользователь платформы (персонал / партнёр / покупатель).
/// code — USR-* (канонический ID, генерация — security-домен).
model User {
  id           String     @id @default(uuid())
  code         String     @unique // USR-00000001
  username     String     @unique
  email        String?    @unique
  passwordHash String
  fullName     String?
  status       UserStatus @default(ACTIVE)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Object scope (RBAC Matrix §3): PARTNER → partnerId, BUYER → customerId.
  partnerId  String?
  customerId String?

  lastLoginAt DateTime?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditLogs           AuditLog[]
  partnerApplications PartnerApplication[]

  @@index([roleId])
  @@index([status])
  @@schema("security")
}

/// Partner onboarding application (Step 1.10) — заявка внешнего продавца на
/// регистрацию/активацию Partner. Живёт в security.* (onboarding identity),
/// НЕ параллельная Partner entity: crm.Partner создаётся/линкуется ТОЛЬКО на
/// approve через CRM-owned service; User.partnerId — единственная связь.
///
/// Статусы не смешивать: User.status / PartnerApplication.status /
/// crm.Partner.status / Product.status / ModerationSubmission.status.
/// Payment/KYC onboarding — отдельный будущий этап (здесь не хранится).
model PartnerApplication {
  id           String                  @id @default(uuid())
  code         String                  @unique // APP-00000001
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ссылка на crm.Partner (без FK) — заполняется только на approve.
  partnerId    String?
  status       PartnerApplicationStatus @default(DRAFT)

  applicantType ApplicantType
  /// Юрлицо: legal/company name.
  legalName    String?
  /// Отображаемое имя бренда/партнёра (обязательно). НЕ identity-ключ.
  brandName    String
  country      String
  registrationNumber String?
  taxId        String?
  website      String?
  contactEmail String
  contactPhone String?
  address      String?
  businessDescription String?
  /// Onboarding-метаданные: slugs ACTIVE категорий, которые заявитель планирует
  /// продавать. НЕ даёт ownership Product (это не Product-привязка).
  serviceCategories Json?
  termsAccepted Boolean              @default(false)

  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedById String?
  reviewedByUsername String?
  decisionReason String?
  /// Оптимистичный замок (CAS): stale-правки/решения отклоняются (409).
  version     Int                   @default(1)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  history PartnerApplicationHistory[]

  @@index([status])
  @@index([userId])
  @@schema("security")
}

/// Журнал PartnerApplication (audit by default) — полная история решений.
model PartnerApplicationHistory {
  id            String   @id @default(uuid())
  applicationId String
  application   PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  action        String
  from          String?
  to            String?
  fields        Json?
  actorId       String?
  actorName     String?
  comment       String?
  createdAt     DateTime @default(now())

  @@index([applicationId])
  @@schema("security")
}

/// Каноническая роль (список ролей зафиксирован, новые — только через ADR).
enum RoleCode {
  ADMIN
  DIRECTOR
  FINANCE
  MARKETER
  ANALYST
  MODERATOR
  SALES_MANAGER
  OPERATOR
  PARTNER
  BUYER

  @@schema("security")
}

model Role {
  id         String           @id @default(uuid())
  code       RoleCode         @unique
  title      String
  users      User[]
  permissions RolePermission[]

  @@schema("security")
}

/// Granular permission (RBAC Matrix §4): например order.accept, booking.confirm.
model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@schema("security")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@schema("security")
}

/// Аудит безопасности: вход/выход, смена роли, доступ/команды (RBAC Matrix §5).
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username   String?
  action     String
  resource   String?
  resourceId String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@schema("security")
}

// ─────────────────────────────── reverse.* ────────────────────────────────
// Reverse Marketplace (ADR-0012, Step 2.2A): request-led demand bounded
// context. ЕДИНСТВЕННЫЙ владелец: reverse.*. НЕ является Sales/Catalog/
// Communication/Security/CRM/Order/Booking/Finance; НЕ transaction system.
//
// Step 2.2A — Seller Commercial Capabilities & Destination Coverage:
//  - seller-declared commercial eligibility (service categories + destinations);
//  - capability ≠ inventory/Product/pricing/availability (Capability ≠ inventory);
//  - legal/registration country НЕ определяет coverage и не подставляется;
//  - capability ≠ entitlement (matching-gate — Step 2.2C, здесь НЕ реализуется);
//  - taxonomy: категории — ref на catalog.Category (DD-028: потребление, НЕ
//    владение); destinations — структурные коды (countryCode/cityCode),
//    иерархия Country→Region→City НЕ замораживается;
//  - один capability на (sellerId, categoryId) — deterministic duplicate rule;
//  - CAS (version) для конкурентных мутаций; audit history; события НЕ
//    эмитятся (нет consumer/business meaning в 2.2A — факты читаются
//    matching-слоем 2.2C напрямую).

/// Lifecycle Seller Commercial Capability (Step 2.2A):
/// DRAFT — создана, публично/для matching НЕ используется;
/// ACTIVE — usable (учитывается в будущем eligibility matching);
/// INACTIVE — деактивирована (не участвует, запись сохраняется, audit).
/// Переходы: DRAFT→ACTIVE (activate), ACTIVE→INACTIVE (deactivate),
/// INACTIVE→ACTIVE (re-activate). No-op при том же состоянии. Никакого
/// деструктивного удаления бизнес-факта.
enum CapabilityStatus {
  DRAFT
  ACTIVE
  INACTIVE

  @@schema("reverse")
}

/// Seller Commercial Capability (Step 2.2A, reverse.*).
model SellerCapability {
  id   String @id @default(uuid())
  code String @unique // CAP-00000001 (IdsService, атомарный счётчик)

  /// Владелец — crm.Partner ref (без FK, ADR-0001). ВСЕГДА из actor.partnerId
  /// (сервер), никогда из body/query.
  sellerId String

  /// Категория/сервисная capability — ref на catalog.Category (без FK).
  /// Catalog остаётся владельцем taxonomy (DD-028). Immutable после создания
  /// (смена категории = deactivate + create нового capability).
  categoryId String
  /// Slug-снапшот категории для отображения/диагностики (НЕ authority).
  categorySlug String

  /// Destination coverage: JSON-массив [{countryCode}, {countryCode, cityCode},
  /// {worldwide: true}]. Worldwide — эксклюзивная запись (НЕ fake country).
  /// countryCode — структурный ISO (^[A-Z]{2}$); cityCode — из канонического
  /// справочника CITY_REF при наличии. Правовая страна Seller НЕ определяет
  /// coverage и НЕ добавляется неявно. Сервер нормализует и сортирует.
  destinations Json

  /// Explicit opt-in/out получения Buyer Requests. Default false — безопасный.
  /// enable/disable НЕ даёт entitlement и НЕ создаёт BuyerRequest/Lead/
  /// Opportunity/Quote/Product.
  acceptsBuyerRequests Boolean @default(false)

  status CapabilityStatus @default(DRAFT)

  /// Optimistic concurrency (CAS): stale expectedVersion → 409.
  version Int @default(1)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Lifecycle milestones (реальные переходы, НЕ updatedAt).
  activatedAt   DateTime?
  deactivatedAt DateTime?

  history SellerCapabilityHistory[]

  // Один capability на (Seller, категорию) — deterministic duplicate rule.
  @@unique([sellerId, categoryId])
  @@index([sellerId])
  @@index([sellerId, status])
  @@index([status, categoryId])
  @@index([status, acceptsBuyerRequests])
  @@schema("reverse")
}

/// Журнал SellerCapability (audit by default, без PII/raw body).
model SellerCapabilityHistory {
  id           String           @id @default(uuid())
  capabilityId String
  capability   SellerCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  action       String
  from         String?
  to           String?
  fields       Json?
  actorId      String?
  actorName    String?
  comment      String?
  createdAt    DateTime         @default(now())

  @@index([capabilityId])
  @@schema("reverse")
}

/// Lifecycle BuyerRequest (Step 2.2B): demand entity, НЕ Sales-сущность.
/// DRAFT — редактируемая/черновик; SUBMITTED — открыта (eligible для будущего
/// matching 2.2C, но matching НЕ выполняется в 2.2B); CANCELLED — закрыта
/// Buyer-ом. MATCHED/DISTRIBUTED/PROPOSAL_RECEIVED/SELECTED/CONVERTED — НЕ
/// здесь (2.2C/2.2D/2.2F).
enum BuyerRequestStatus {
  DRAFT
  SUBMITTED
  CANCELLED

  @@schema("reverse")
}

/// Buyer Request (Step 2.2B, reverse.*) — demand-led entry: Buyer описывает,
/// что хочет купить, без выбора опубликованного Product. Владелец: reverse.*
/// (ADR-0012). НЕ Lead/Opportunity/Quote/Sale/Order/Booking/Communication.
///
/// Инварианты:
///  - buyerId — crm.Customer ref (без FK), ВСЕГДА из actor.customerId;
///  - создание НЕ создаёт Lead/Opportunity/Quote/Sale/Order/Booking/Product;
///  - categoryId — ref на catalog.Category (Catalog владелец taxonomy);
///  - destinations — та же структурная representation, что у capability
///    (НЕ выводится из home/legal location Buyer);
///  - даты — date-only (UTC midnight), без timezone/time-slot (2.8A);
///  - PAX — минимальный (adults/children/infants), БЕЗ PII;
///  - budget/preferences — НЕ-binding demand hints (не цена Quote/Sale);
///  - acquisitionSource — серверный, всегда BUYER_REQUEST (2.2F сохранит его
///    через canonical Sales → Order pipeline);
///  - CAS (version); audit history; события НЕ эмитятся (нет consumer в 2.2B);
///  - никаких Seller/matching/distribution полей.
model BuyerRequest {
  id   String @id @default(uuid())
  code String @unique // BRQ-00000001 (IdsService, атомарный счётчик)

  /// Владелец — crm.Customer ref (без FK). Сервер из actor.customerId.
  buyerId String

  /// Категория/сервисный intent — ref на catalog.Category (без FK).
  /// Immutable НЕ требуется: редактируется в DRAFT (это черновик Buyer-а).
  categoryId   String
  categorySlug String

  /// Destination intent: [{countryCode}, {countryCode, cityCode}, {worldwide}]
  /// (та же нормализация, что у capability). НЕ legal/home location.
  destinations Json

  /// Даты: date-only (YYYY-MM-DD → UTC midnight), не в прошлом.
  /// Оба nullable = открытые даты; from <= to; from == to — точная дата.
  serviceDateFrom DateTime?
  serviceDateTo   DateTime?

  /// PAX (минимальный, без PII): минимум 1 взрослый.
  adults   Int @default(1)
  children Int @default(0)
  infants  Int @default(0)

  /// Не-binding demand hint: {currency, min?, max?} (валидируется сервером).
  budget Json?
  /// Category-dependent demand preferences (free-form hints, НЕ binding,
  /// без контактов/PII; размер ограничен).
  preferences Json?

  /// Серверный acquisition source: всегда "BUYER_REQUEST" (клиент не передаёт).
  acquisitionSource String @default("BUYER_REQUEST")

  status    BuyerRequestStatus @default(DRAFT)
  version   Int                @default(1)
  createdBy String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  /// Milestones (реальные переходы, НЕ updatedAt).
  submittedAt DateTime?
  cancelledAt DateTime?

  /// Step 2.2F: канонический выбранный SellerProposal (trusted ref БЕЗ FK,
  /// конвенция ADR-0001/ADR-0012). Server-derived ТОЛЬКО командой selection
  /// (reverse.proposal.select_own); клиент не передаёт. @unique = DB-invariant
  /// «один выбранный Proposal на BuyerRequest» И «один request на выбранный
  /// Proposal» (one-winner при concurrent A/B selection). Selection/конверсия
  /// атомарны с созданием Opportunity (Sales owner service, единая tx).
  selectedProposalId String? @unique

  history        BuyerRequestHistory[]
  distributions  BuyerRequestDistribution[]
  proposals      SellerProposal[]

  @@index([buyerId])
  @@index([buyerId, status])
  @@index([status, categoryId])
  @@index([status, createdAt])
  @@schema("reverse")
}

/// Детерминированная per-Seller distribution-факт (Step 2.2C, reverse.*).
/// Server-authoritative: создаётся ТОЛЬКО системной matching-командой
/// (reverse.match.run); Seller НЕ может self-match; Buyer НЕ мутирует.
///
/// Инварианты:
///  - MATCHED/DISTRIBUTED ≠ CONTACT DISCLOSED (никаких контактов/PII);
///  - matching НЕ создаёт Lead/Opportunity/Quote/Sale/Order/Booking;
///  - sellerId — crm.Partner ref (без FK), из server-owned state;
///  - eligibility evaluated на момент run (request SUBMITTED + category match +
///    destination coverage + capability ACTIVE + acceptsBuyerRequests + Seller
///    ACTIVE); capability ≠ entitlement (entitlement authority для reverse
///    marketplace отсутствует — participation gate = capability-level);
///  - уникальность (buyerRequestId, sellerId) — idempotent retry;
///  - durable: при CANCELLED request row сохраняется (история не удаляется),
///    Seller projection показывает актуальный request.status;
///  - UUID-only (без business-префикса: internal fact, §34 prompt).
model BuyerRequestDistribution {
  id             String        @id @default(uuid())
  buyerRequestId String
  buyerRequest   BuyerRequest  @relation(fields: [buyerRequestId], references: [id], onDelete: Cascade)
  /// crm.Partner ref (без FK). Всегда из server-owned eligibility state.
  sellerId       String
  distributedAt  DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  proposals SellerProposal[]

  @@unique([buyerRequestId, sellerId])
  @@index([sellerId])
  @@index([sellerId, distributedAt])
  @@schema("reverse")
}

/// Журнал BuyerRequest (audit by default, без контактного PII/raw body).
model BuyerRequestHistory {
  id        String       @id @default(uuid())
  requestId String
  request   BuyerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action    String
  from      String?
  to        String?
  fields    Json?
  actorId   String?
  actorName String?
  comment   String?
  createdAt DateTime     @default(now())

  @@index([requestId])
  @@schema("reverse")
}

/// Lifecycle Seller Proposal (Step 2.2D, reverse.*): DRAFT — редактируемый
/// черновик; SUBMITTED — направлен Buyer-у (виден в Buyer projection);
/// WITHDRAWN — отозван Seller-ом (терминал). ACCEPTED/SELECTED/CONVERTED/
/// QUOTED/WON/LOST НЕ здесь — Buyer selection и конверсия принадлежат
/// Step 2.2F (DD-030 gate).
enum ProposalStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN

  @@schema("reverse")
}

/// Seller Proposal (Step 2.2D, reverse.*, ADR-0012) — pre-commercial
/// competitive ответ Seller-а на распределённый ему BuyerRequest.
///
/// Инварианты:
///  - 0..N Proposals на BuyerRequest; ОДИН Proposal на (Seller, BuyerRequest)
///    (unique, deterministic duplicate rule, idempotent retry);
///  - Proposal ≠ Sales Quote: НЕ reuse sales.Quote, НЕ второй binding Quote
///    engine; amount/currency — НЕ-binding индикация (authority — canonical
///    Quote Step 2.3); NULL amount = PRICE_ON_REQUEST (честное отсутствие,
///    НЕ фабрикуется ноль);
///  - sellerId — crm.Partner ref (без FK), ВСЕГДА из actor.partnerId;
///  - distributionId — reverse.BuyerRequestDistribution ref (FK внутри
///    reverse.*): создание ТРЕБУЕТ реальной канонической distribution к этому
///    Seller-у (клиент не может forged distribution/self-match);
///  - request gate: Proposal создаётся/сабмитится только для SUBMITTED
///    request; CANCELLED — новые Proposal запрещены; существующие сохраняются
///    (история durable); withdraw допустим всегда (решение Seller-а);
///  - PROPOSAL EXISTS ≠ CONTACT DISCLOSED: контент — plain text без
///    контактов/URL (анти-disintermediation, консервативная валидация);
///  - создание НЕ создаёт Lead/Opportunity/Quote/Sale/Order/Booking/Product;
///  - acquisitionSource остаётся BUYER_REQUEST (2.2F сохранит при конверсии);
///  - CAS (version); history/audit; события НЕ эмитятся (consumer — 2.2E/F
///    читают напрямую; explicit command — наблюдаемый trigger);
///  - DD-030 compatibility: schema поддерживает будущую конверсию без выбора
///    target сейчас (нет salesQuoteId/leadId/opportunityId полей).
model SellerProposal {
  id   String @id @default(uuid())
  code String @unique // PRP-00000001 (IdsService, атомарный счётчик)

  /// Владелец — crm.Partner ref (без FK). ВСЕГДА из actor.partnerId (сервер),
  /// никогда из body/query.
  sellerId String

  /// Demand ref — reverse.BuyerRequest (FK внутри reverse.*).
  buyerRequestId String
  buyerRequest   BuyerRequest @relation(fields: [buyerRequestId], references: [id], onDelete: Cascade)

  /// Доказательство канонической distribution (reverse.BuyerRequestDistribution,
  /// FK внутри reverse.*): Proposal может существовать ТОЛЬКО на реально
  /// распределённый Seller-у request. distributionId — server-derived
  /// (резолвится сервисом по (buyerRequestId, sellerId), клиент не передаёт).
  distributionId String
  distribution   BuyerRequestDistribution @relation(fields: [distributionId], references: [id])

  /// Индикативная коммерческая информация (НЕ-binding): amount — Decimal,
  /// non-negative, без silent currency conversion; NULL = PRICE_ON_REQUEST
  /// (честное отсутствие); currency — ISO 4217 (обязателен при amount).
  amount   Decimal? @db.Decimal(12, 2)
  currency String?

  /// Контент Proposal (free-text, size-limited, plain text, анти-injection,
  /// анти-disintermediation — без контактов/URL; НЕ DLP-safe store).
  description      String?
  includedServices String?
  exclusions       String?
  conditions       String?
  notes            String?
  /// Validity hint (date-only, UTC midnight) — НЕ Sales Quote expiry semantics;
  /// это Reverse Marketplace fact.
  validUntil DateTime?

  status  ProposalStatus @default(DRAFT)
  /// Optimistic concurrency (CAS): stale expectedVersion → 409.
  version Int @default(1)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Lifecycle milestones (реальные переходы, НЕ updatedAt).
  submittedAt DateTime?
  withdrawnAt DateTime?

  /// ── Step 2.2F — Selection/Conversion state (reverse.*, server-owned) ──
  /// Заполняются ТОЛЬКО командой Buyer selection (единая атомарная tx
  /// с созданием canonical Opportunity в sales.*). Статус Proposal НЕ меняется
  /// (SELECTED/CONVERTED НЕ вводятся — lifecycle остаётся DRAFT/SUBMITTED/
  /// WITHDRAWN); selection — отдельный факт. `convertedOpportunityId` — trusted
  /// ref на sales.Opportunity (без FK); @unique = DB-invariant «один Proposal →
  /// максимум одна Opportunity» (защита duplicate conversion, §12/§34).
  selectedAt          DateTime?
  convertedOpportunityId String? @unique
  convertedAt         DateTime?

  history SellerProposalHistory[]

  // Один Proposal на (Seller, BuyerRequest) — deterministic duplicate rule.
  @@unique([buyerRequestId, sellerId])
  @@index([sellerId])
  @@index([sellerId, status])
  @@index([buyerRequestId, status])
  @@schema("reverse")
}

/// Журнал SellerProposal (audit by default, без контактного PII/raw body).
model SellerProposalHistory {
  id         String         @id @default(uuid())
  proposalId String
  proposal   SellerProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  action     String
  from       String?
  to         String?
  fields     Json?
  actorId    String?
  actorName  String?
  comment    String?
  createdAt  DateTime       @default(now())

  @@index([proposalId])
  @@schema("reverse")
}

// ─────────────────────────────── sales.* ────────────────────────────────
// Sales Domain Foundation (Phase 2 Step 2.1). Отдельный bounded context со своей
// схемой БД. Владеет ТОЛЬКО Sales-сущностями (Lead/Opportunity/Quote/Sale +
// history). НЕ владеет Order/Booking/Payment/Finance; НЕ пишет в Catalog/CRM/
// Order/Booking/Security (ADR-0001). Cross-context ссылки (customerId/productId/
// assignedToId) — по ID без FK, валидируются сервисом read-by-ID.
//
// Инварианты:
//  - Sale ≠ Order: foundation-статусы НЕ означают OrderRequested/paid/fulfilled;
//    граница Sale completion → OrderRequested — Step 2.4 (здесь НЕ публикуется);
//  - behavioral события (Marketplace/Storefront) НЕ создают Lead автоматически;
//  - money-поля ОСОЗНАННО отсутствуют: monetary contract — Step 2.3A/2.4;
//  - temporal: createdAt/updatedAt (entity time); lifecycle milestones — только
//    реальные transition-команды (НЕ updatedAt); новых legacy-строк нет.

/// Lifecycle Lead (Step 2.1, минимальный): NEW → QUALIFIED (готовность к
/// сделке) | DISQUALIFIED (терминал). Дальнейшая семантика — Sales Center (2.2).
enum LeadStatus {
  NEW
  QUALIFIED
  DISQUALIFIED

  @@schema("sales")
}

/// Ранняя sales-сущность (интерес). НЕ behavioral event и НЕ автоматический
/// consumer телеметрии (ContactClick — intent signal, не canonical Lead).
/// Контакты/PII не копируются — предпочтителен canonical customerId
/// (crm.Customer ref); ранний Lead может быть без Customer (только name).
model Lead {
  id          String     @id @default(uuid())
  code        String     @unique // LED-00000001 (IdsService, атомарный счётчик)
  name        String
  /// Ссылка на crm.Customer (без FK). NULL для раннего Lead-интереса.
  customerId  String?
  /// Ссылка на security.User (ответственный, без FK). НЕ является security source.
  assignedToId String?
  status      LeadStatus @default(NEW)
  version     Int        @default(1)
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  opportunities Opportunity[]
  history       LeadHistory[]

  @@index([status])
  @@index([customerId])
  @@index([assignedToId])
  // Step 2.2 (Sales Center): композитные индексы под реальные filter/queue паттерны
  // (status + createdAt период; assignedToId + status). Не speculative — соответствуют
  // добавленным фильтрам list/KPI/queues.
  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@schema("sales")
}

/// Журнал Lead (audit by default) — история создания/правок/переходов.
model LeadHistory {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  action    String
  from      String?
  to        String?
  fields    Json?
  actorId   String?
  actorName String?
  comment   String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@schema("sales")
}

/// Lifecycle Opportunity (Step 2.1, минимальный): NEW → OPEN → WON | LOST
/// (терминалы). Полная Sales Center семантика — Step 2.2.
enum OpportunityStatus {
  NEW
  OPEN
  WON
  LOST

  @@schema("sales")
}

/// Sales opportunity внутри Sales domain. НЕ Order pre-state: lifecycle
/// остаётся внутри Sales; никаких Order-related статусов.
model Opportunity {
  id           String            @id @default(uuid())
  code         String            @unique // OPP-00000001
  title        String
  leadId       String?
  lead         Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId   String?
  assignedToId String?
  status       OpportunityStatus @default(NEW)
  version      Int               @default(1)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // ── Step 2.2F — Reverse Marketplace provenance (DD-030, server-owned) ──
  /// Trusted ref на reverse.BuyerRequest (без FK; ADR-0001/ADR-0012).
  /// Заполняется ТОЛЬКО конверсией выбранного Proposal (Sales owner method).
  buyerRequestId String?
  /// Trusted ref на reverse.SellerProposal (без FK). @unique = DB-invariant
  /// «selected Proposal → максимум одна Opportunity» (защита duplicate
  /// conversion при retry/конкурентности, DD-030 §12).
  proposalId     String?  @unique
  /// Выбранный Seller — crm.Partner ref (без FK). Коммерческий контур: Seller
  /// продавца, НЕ internal staff owner (assignedToId остаётся staff-owner).
  sellerId       String?
  /// Server-derived acquisition source (клиент не передаёт). Конверсия из
  /// BuyerRequest → BUYER_REQUEST; staff-созданные Opportunity → NULL (честно,
  /// без угадывания). Пропагируется далее: Quote → Checkout → Sale → Order.
  acquisitionSource SalesAcquisitionSource?

  quotes  Quote[]
  sales   Sale[]
  history OpportunityHistory[]

  @@index([status])
  @@index([leadId])
  @@index([customerId])
  // Step 2.2: композитные индексы (status + createdAt, assignedToId + status).
  @@index([status, createdAt])
  @@index([assignedToId, status])
  // Step 2.2F: provenance queries (поиск конверсий по request/seller).
  @@index([buyerRequestId])
  @@index([sellerId])
  @@schema("sales")
}

/// Журнал Opportunity (audit by default).
model OpportunityHistory {
  id            String   @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  action        String
  from          String?
  to            String?
  fields        Json?
  actorId       String?
  actorName     String?
  comment       String?
  createdAt     DateTime @default(now())

  @@index([opportunityId])
  @@schema("sales")
}

/// Lifecycle Quote (Step 2.1, integrity-минимум): DRAFT → ISSUED.
/// Полный commercial offer flow (pricing/discounts/validity/acceptance/PDF) —
/// Step 2.3; здесь никаких pricing/тарифов/snapshot и scheduler-ов.
enum QuoteStatus {
  DRAFT
  ISSUED

  @@schema("sales")
}

/// Step 2.3: тип скидки на КП (минимальная модель: NONE/PERCENTAGE/FIXED).
/// PERCENTAGE — процент от subtotal (0..100); FIXED — фиксированная сумма в
/// валюте КП (0..subtotal). Backend вычисляет discountAmount; клиент передаёт
/// только value-параметр в разрешённых пределах. Никаких promo/coupon/campaign.
enum QuoteDiscountType {
  NONE
  PERCENTAGE
  FIXED

  @@schema("sales")
}

/// Quote foundation. Money-поля отсутствуют осознанно (см. sales header).
model Quote {
  id            String      @id @default(uuid())
  code          String      @unique // QTE-00000001
  customerId    String?
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  /// Canonical Catalog Product ref (без FK), предмет КП.
  /// Step 2.3: legacy/foundation single-ref колонка. Новый commercial flow
  /// использует QuoteItem (состав) — колонка остаётся nullable с честной
  /// семантикой (quote, созданные до 2.3, могут нести одиночный ref).
  productId     String?
  status        QuoteStatus @default(DRAFT)
  version       Int         @default(1)
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  /// Step 2.2F: server-derived acquisition source, унаследованный из
  /// Opportunity.acquisitionSource при создании Quote по opportunityId
  /// (Reverse-конверсия → BUYER_REQUEST; direct/staff → NULL честно).
  /// Checkout затем выводит свой source из Quote (quote.acquisitionSource ??
  /// DIRECT) — без client authority и без нового Acquision-домена.
  acquisitionSource SalesAcquisitionSource?

  // ── Step 2.3 — Commercial Offer (money/validity/discount, backend-authoritative) ──
  /// Единая валюта КП (ISO 4217 code). Источник — Catalog Tariff.currency
  /// (все items одной валюты; свободный список не вводится — Finance Currency
  /// master data — будущий домен). Для DRAFT — валюта первого item.
  currency String @default("USD")
  /// Срок действия коммерческого предложения (UTC instant). Обязателен при ISSUE;
  /// server validates > now. Не заменяет issuedAt (temporal contract).
  validUntil   DateTime?
  /// Lifecycle time ISSUE (temporal contract; updatedAt не заменяет).
  issuedAt     DateTime?
  discountType QuoteDiscountType @default(NONE)
  /// PERCENTAGE: 0..100; FIXED: >= 0 (в валюте КП). Игнорируется при NONE.
  discountValue Decimal? @db.Decimal(12, 2)
  /// Вычисленное backend-ом значение скидки (subtotal - total), замораживается при ISSUE.
  discountAmount Decimal? @db.Decimal(12, 2)
  /// Сумма строк (без скидки). Для DRAFT — вычисляется при чтении; персистится при ISSUE.
  subtotal Decimal? @db.Decimal(12, 2)
  /// Итог = subtotal - discountAmount (>= 0). Персистится при ISSUE (immutable).
  total Decimal? @db.Decimal(12, 2)

  sale            Sale?
  history         QuoteHistory[]
  items           QuoteItem[]
  travelers       QuoteTraveler[]
  /// Step 2.3A: коммерческие intents, производные от ISSUED Quote.
  checkoutIntents CheckoutIntent[]

  @@index([status])
  @@index([opportunityId])
  @@index([customerId])
  // Step 2.2: композитный индекс (status + createdAt).
  @@index([status, createdAt])
  @@schema("sales")
}

/// Step 2.3: строка коммерческого предложения — Sales-owned immutable snapshot
/// Catalog Product/Tariff (продукт и тариф остаются Catalog-owned; КП НЕ копирует
/// Catalog ownership). Snapshot фиксируется при формировании DRAFT и замораживается
/// при ISSUE: последующие изменения Catalog не меняют issued КП.
model QuoteItem {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Canonical refs (без FK, ADR-0001).
  productId String
  /// Snapshot канонического кода (PRD-*) для исторического display.
  productCode String
  /// Snapshot названия Product.
  productTitle String
  tariffId String
  /// Snapshot кода тарифа (TRF-*).
  tariffCode String
  /// Snapshot названия Tariff.
  tariffName String

  /// Количество/участники (>= 1).
  quantity Int @default(1)
  /// Step 1.8C: сервисная дата, на которую резолвлена unitPrice (date-only UTC
  /// midnight). NULL — legacy/base snapshot без даты. Snapshot для provenance
  /// (STRICT REVIEW §41: amount/currency/serviceDate/tariff ref); НЕ изменяется
  /// при reprice — frozen commercial fact.
  serviceDate DateTime?
  /// Snapshot unit price из Catalog Tariff (Decimal(12,2), backend-authoritative).
  unitPrice Decimal @db.Decimal(12, 2)
  /// Валюта тарифа (единая для КП).
  currency String @default("USD")
  /// Сумма строки = unitPrice * quantity (backend, Decimal, без JS float).
  amount Decimal @db.Decimal(12, 2)
  /// Step 1.8D: провенанс применённых коммерческих ограничений на момент
  /// binding (Quote ISSUE) — [{type, value, source, code}]. Frozen documentary
  /// snapshot, НЕ re-validated после ISSUE (canonical freeze, 1.8C §44).
  /// NULL — legacy/base snapshot без даты (ограничения не оценивались).
  restrictionSnapshot Json?

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@schema("sales")
}

/// Step 2.3: Sales-owned pre-order traveler context (кто входит в предложение).
/// МИНИМУМ для offer composition/pricing: имя + опциональная дата рождения
/// (age-based pricing). НЕ копирует passport/document/payment data (OrderTraveler /
/// Passenger — свои домены; паспортные данные — только при доказанной необходимости
/// в их доменах, Step 2.5 создаст OrderTraveler из canonical snapshot).
model QuoteTraveler {
  id        String @id @default(uuid())
  quoteId   String
  quote     Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  birthDate DateTime?
  createdAt DateTime @default(now())

  @@index([quoteId])
  @@schema("sales")
}

/// Журнал Quote (audit by default).
model QuoteHistory {
  id        String   @id @default(uuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  action    String
  from      String?
  to        String?
  fields    Json?
  actorId   String?
  actorName String?
  comment   String?
  createdAt DateTime @default(now())

  @@index([quoteId])
  @@schema("sales")
}

/// Lifecycle Sale (Step 2.1, минимальный): OPEN → CLOSED (закрытие в
/// sales-контексте). НЕ означает paid/fulfilled/OrderRequested.
enum SaleStatus {
  OPEN
  CLOSED

  @@schema("sales")
}

/// Sale — Sales-domain entity. НЕ Order: не создаёт Order/Booking/Payment,
/// не резервирует Availability, не меняет inventory. Sale completion →
/// canonical OrderRequested — Step 2.4 (единственная граница).
model Sale {
  id            String       @id @default(uuid())
  code          String       @unique // SAL-00000001
  customerId    String?
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  quoteId       String?      @unique
  quote         Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  /// Step 2.4: CheckoutIntent, чей commercial контекст завершается этим Sale
  /// (cross-schema ref без FK). Один Sale → один Checkout (unique).
  checkoutIntentId String?   @unique
  status        SaleStatus   @default(OPEN)
  version       Int          @default(1)
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // ── Step 2.4 — Immutable commercial snapshot (замораживается при completion) ──
  /// Заполняется ТОЛЬКО при completeSale (не backfill). NULL = Sale ещё не
  /// завершён (OPEN) ИЛИ legacy (Step 2.1 CLOSED без snapshot — честно, без
  /// угадывания). Order consumer читает эти факты — без повторного Catalog
  /// reprice (G3).
  currency        String?
  subtotal        Decimal?          @db.Decimal(12, 2)
  discountType    QuoteDiscountType?
  discountValue   Decimal?          @db.Decimal(12, 2)
  discountAmount  Decimal?          @db.Decimal(12, 2)
  total           Decimal?          @db.Decimal(12, 2)
  paymentScheme   PaymentScheme?
  prepaymentType  PaymentPrepaymentType?
  prepaymentValue Decimal?          @db.Decimal(12, 2)
  initialAmount   Decimal?          @db.Decimal(12, 2)
  remainingAmount Decimal?          @db.Decimal(12, 2)
  acquisitionSource SalesAcquisitionSource?
  serviceDate     DateTime?
  /// Ссылка на catalog.AvailabilityReservation (без FK) — первая/каноническая
  /// резервация Sale. Полный список резерваций — по sourceSaleId в catalog.*.
  reservationId   String?
  /// Идемпотентность/traceability: событие OrderRequested этого Sale.
  orderRequestedEventId String?
  /// Lifecycle milestone completion (Step 2.4): реальный переход OPEN → CLOSED.
  /// updatedAt НЕ является milestone (§38).
  completedAt     DateTime?
  completedById   String?

  history SaleHistory[]

  @@index([status])
  @@index([opportunityId])
  @@index([customerId])
  // Step 2.2: композитный индекс (status + createdAt).
  @@index([status, createdAt])
  @@index([status, completedAt])
  @@schema("sales")
}

/// Журнал Sale (audit by default).
model SaleHistory {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  action    String
  from      String?
  to        String?
  fields    Json?
  actorId   String?
  actorName String?
  comment   String?
  createdAt DateTime @default(now())

  @@index([saleId])
  @@schema("sales")
}

// ─────────────────────── sales.* — Step 2.3A Checkout ───────────────────────
// Checkout / Commercial Intent Foundation (Step 2.3A, см. docs/architecture/
// checkout-commercial-intent.md). Владелец — Sales (sales.*, ADR-0001):
// НЕ новый bounded context и НЕ Order pre-state.
//
// Инварианты:
//  - CheckoutIntent создаётся ТОЛЬКО из ISSUED Quote (binding-price: frozen
//    Quote totals, БЕЗ reprice от Catalog — один price authority §9);
//  - frontend НЕ источник цены: money-поля server-copied из Quote и immutable;
//  - availability — read-only "checked, not reserved": Sales НЕ пишет
//    catalog.Availability (ADR-0001); reservation/locking owner — Order/Booking
//    boundary (Step 2.4), здесь только честный read-model (§12–§15, DD-022);
//  - acquisitionSource — server-derived (internal-assisted = DIRECT), immutable;
//  - options — НЕ введены (каноническая catalog options модель отсутствует,
//    DD-023; запрещено invent arbitrary JSON options §21);
//  - payment terms — НЕ введены (Step 2.3B); Sale completion/OrderRequested —
//    Step 2.4 (здесь отсутствуют);
//  - serviceDate — date-only (YYYY-MM-DD → UTC midnight); time-slot/timezone —
//    Step 2.8A (IANA timezone), не симулируется.

/// Lifecycle CheckoutIntent (2.3A foundation): ACTIVE → CANCELLED.
/// БЕЗ PAID/COMPLETED/ORDERED/BOOKED/FULFILLED (Step 2.4+, §32).
enum CheckoutStatus {
  ACTIVE
  CANCELLED

  @@schema("sales")
}

/// Канонические acquisition source values (Step 2.5B): MARKETPLACE /
/// PARTNER_STOREFRONT / DIRECT (internal/manual). Schema-local enum (Prisma
/// multiSchema запрещает cross-schema enum ref); Step 2.5B: + BUYER_REQUEST
/// (Roadmap Amendment, аддитивно; Reverse Marketplace НЕ реализуется).
/// PARTNER_CUSTOM_DOMAIN / API — «позднее» по Roadmap 2.5B, НЕ добавляются.
enum SalesAcquisitionSource {
  MARKETPLACE
  PARTNER_STOREFRONT
  DIRECT
  BUYER_REQUEST

  @@schema("sales")
}

/// Канонические payment schemes (Step 2.3B, Roadmap v3). Описывают ОБЯЗАТЕЛЬСТВО
/// покупателя и график/условия оплаты, НЕ Payment/PSP/authorization/capture.
/// Due semantics несёт сам enum (BEFORE_SERVICE / AT_SERVICE) — без fake
/// due timestamp (time-model — 2.8A; due-date/reminders — 2.12F/Finance).
enum PaymentScheme {
  /// Вся сумма к оплате сейчас; remaining = 0. Без параметров.
  FULL_PREPAYMENT
  /// Предоплата (PERCENTAGE|FIXED) сейчас, строго 0 < initial < total;
  /// остаток — до оказания услуги (BEFORE_SERVICE).
  PARTIAL_PREPAYMENT
  /// Задаток (PERCENTAGE|FIXED), ЧАСТЬ total (Roadmap 2.12F: «Deposit, 30/70»);
  /// remaining = total - initial — при оказании услуги (AT_SERVICE).
  DEPOSIT
  /// 0 сейчас, вся сумма до оказания услуги (BEFORE_SERVICE).
  PAY_LATER
  /// 0 сейчас, вся сумма при оказании услуги (AT_SERVICE; отличим от PAY_LATER).
  PAY_AT_SERVICE

  @@schema("sales")
}

/// Как задаётся prepayment для PARTIAL_PREPAYMENT / DEPOSIT (дискриминированный
/// контракт: тип НЕ угадывается по значению).
enum PaymentPrepaymentType {
  PERCENTAGE
  FIXED

  @@schema("sales")
}

/// Authoritative checkout/commercial-intent context (Step 2.3A).
model CheckoutIntent {
  id          String   @id @default(uuid())
  code        String   @unique // CKT-00000001 (IdsService, атомарный счётчик)
  /// ISSUED Quote (обязателен): binding-price источник. Restrict — Quote с
  /// привязанным intent не удаляется.
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  /// crm.Customer ref (без FK). По умолчанию наследуется из Quote; staff может
  /// задать при создании (server валидирует existence). Scope фиксирован после
  /// создания (нет customer-мутации).
  customerId  String?
  status      CheckoutStatus @default(ACTIVE)
  version     Int      @default(1)

  // ── Frozen commercial snapshot (server-copied из issued Quote, immutable) ──
  /// Единая валюта (из Quote; frontend не передаёт).
  currency     String
  /// Итог строк (без скидки) — Quote.subtotal (frozen).
  subtotal     Decimal  @db.Decimal(12, 2)
  discountType QuoteDiscountType @default(NONE)
  discountValue Decimal? @db.Decimal(12, 2)
  discountAmount Decimal? @db.Decimal(12, 2)
  /// Итог = subtotal - discountAmount (frozen; НЕ paid amount — §49).
  total        Decimal  @db.Decimal(12, 2)

  // ── Step 2.3B — Payment Terms (коммерческие условия, server-derived) ──
  /// Выбранная схема оплаты. NULL = payment terms not selected (честно, НЕ
  /// подразумевается дефолтная схема; никакого backfill для existing rows).
  paymentScheme  PaymentScheme?
  /// PERCENTAGE|FIXED — как задан prepayment (PARTIAL/DEPOSIT); NULL для схем
  /// без параметра (FULL/PAY_LATER/PAY_AT_SERVICE). Discriminated, не по значению.
  prepaymentType PaymentPrepaymentType?
  /// PERCENTAGE: 0 < p < 100; FIXED: 0 < v < total (валюта Checkout).
  /// NULL для схем без параметра.
  prepaymentValue Decimal? @db.Decimal(12, 2)
  /// Server-derived: сколько покупатель платит сейчас (в валюте Checkout).
  /// FULL → total; PARTIAL/DEPOSIT → вычислено (round_half_up);
  /// PAY_LATER/PAY_AT_SERVICE → 0. Frontend НЕ передаёт.
  initialAmount    Decimal? @db.Decimal(12, 2)
  /// Server-derived: total - initialAmount (для всех схем, где prepayment —
  /// часть total). Инвариант: initialAmount + remainingAmount == total.
  remainingAmount  Decimal? @db.Decimal(12, 2)

  // ── Service context ──
  /// Дата услуги: date-only (YYYY-MM-DD → UTC midnight). Time/timezone — 2.8A.
  serviceDate  DateTime?
  /// Server-derived acquisition source (internal-assisted = DIRECT), immutable.
  acquisitionSource SalesAcquisitionSource @default(DIRECT)

  cancelledAt  DateTime?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  travelers CheckoutIntentTraveler[]
  history   CheckoutIntentHistory[]

  @@index([status])
  @@index([quoteId])
  @@index([customerId])
  @@index([status, createdAt])
  @@schema("sales")
}

/// Traveler контекст intent (минимум: имя + опциональная дата рождения;
/// наследуется из QuoteTraveler при создании, редактируем отдельной командой).
/// Без passport/document/payment данных (privacy §42).
model CheckoutIntentTraveler {
  id               String         @id @default(uuid())
  checkoutIntentId String
  checkoutIntent   CheckoutIntent @relation(fields: [checkoutIntentId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  birthDate        DateTime?
  createdAt        DateTime       @default(now())

  @@index([checkoutIntentId])
  @@schema("sales")
}

/// Журнал CheckoutIntent (audit by default, без PII/raw body).
model CheckoutIntentHistory {
  id               String         @id @default(uuid())
  checkoutIntentId String
  checkoutIntent   CheckoutIntent @relation(fields: [checkoutIntentId], references: [id], onDelete: Cascade)
  action           String
  from             String?
  to               String?
  fields           Json?
  actorId          String?
  actorName        String?
  comment          String?
  createdAt        DateTime       @default(now())

  @@index([checkoutIntentId])
  @@schema("sales")
}
