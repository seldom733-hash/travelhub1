// ============================================================================
// TravelHub Phase 1+2 — Prisma schema (PostgreSQL, multiSchema)
//
// Каждый бизнес-домен владеет ОТДЕЛЬНОЙ схемой БД (bounded context):
//   events.*   — инфраструктура: transactional outbox + inbox идемпотентности
//   catalog.*  — Catalog Center: Product, Category, Tariff, Availability
//   crm.*      — CRM mini: Customer, Contact, Company, Partner, Supplier
//   order.*    — Order Center: Order, OrderItem, OrderTraveler, Fulfillment
//   booking.*  — Booking Center: Booking, Reservation, SupplierConfirmation, Passenger
//   security.* — Auth+RBAC (Phase 2): User, Role, Permission, AuditLog
//
// Правила (Baseline, Phase 1+2):
//  - МЕЖДУ схемами НЕТ foreign keys — только ссылки по ID (productId, customerId, orderId).
//  - Ни один домен не пишет в таблицы чужой схемы (только через события/API).
//  - Канонические ID: PRD-*/ORD-*/BKG-*/CUS-* + 8 цифр (генерирует домен-владелец).
//  - Audit by default: каждая схема имеет *_history таблицу.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Partial indexes (review fix Step 1.2): DB-level invariant — не более одного
  // primary media на Product (CREATE UNIQUE INDEX ... WHERE "isPrimary" = true).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["events", "catalog", "crm", "order", "booking", "security", "communication", "sales", "reverse"]
}

// ─────────────────────────────── events.* ────────────────────────────────

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED

  @@schema("events")
}

/// Transactional outbox: доменное событие пишется атомарно с изменением сущности
/// (в той же транзакции), после коммита публикуется подписчикам (publishPending).
model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  correlationId String?
  causationId   String?
  /// Step 1.15A: typed business event actor (BusinessEventActor JSON:
  /// {type: "USER"|"SYSTEM"|"UNKNOWN", id?}). NULL — legacy/unknown, без
  /// backfill. НЕ включает username/email/permissions (только canonical ID).
  actor         Json?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  error         String?
  /// Step 2.4 (G2, outbox reliability): критичные события могут быть явно
  /// retryable. FAILED остаётся терминальным для legacy-событий (Step 1.18
  /// конвенция сохранена); retryable=true — только для событий, emitted с
  /// флагом (OrderRequested). См. EventBusService.retryFailed.
  retryable     Boolean      @default(false)
  /// Step 2.4: минимальный durable retry — следующая допустимая попытка
  /// (backoff). NULL = retry готов немедленно. Backoff helper — чистый.
  nextAttemptAt DateTime?
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?

  @@index([status, createdAt])
  @@index([status, retryable, attempts])
  @@index([aggregateType, aggregateId])
  @@schema("events")
}

/// Inbox идемпотентных consumers: событие, уже обработанное consumer-ом,
/// не обрабатывается повторно (unique consumerId+eventId).
model InboxEvent {
  id          String   @id @default(uuid())
  consumerId  String
  eventId     String
  processedAt DateTime @default(now())

  @@unique([consumerId, eventId])
  @@schema("events")
}

/// Атомарный счётчик канонических бизнес-ID (PRD-/ORD-/BKG-/CUS-/TH-YYYY-...).
/// Инкремент выполняется upsert-ом в транзакции домена-владельца.
model BusinessSequence {
  prefix String @id // "PRD", "ORD", "BKG", "CUS", "CNT", "CAT", "TRF", "TH-2026"
  value  Int    @default(0)

  @@schema("events")
}

// ─────────────────────────────── catalog.* ───────────────────────────────

enum ProductStatus {
  DRAFT
  COMPLETE
  REVIEWED
  PUBLISHED
  CHANGED
  ARCHIVED

  @@schema("catalog")
}

/// Жизненный цикл Seller Commercial / Service Unit (Step 1.8A, DD-025 B).
/// DRAFT → PUBLISHED → ARCHIVED (публикация — Catalog publication authority,
/// гейт: родительский Product PUBLISHED; без второго moderation engine).
enum ServiceUnitStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("catalog")
}

/// Price basis (Step 1.8B, Universal Pricing §5) — одиночный семантический тег
/// Rate Plan-уровня; quantity/duration — отдельные dimensions (STRICT REVIEW §22,
/// без compound-строк вида PER_ROOM_PER_NIGHT). NULL = legacy-тариф без basis.
enum PriceBasis {
  PER_UNIT
  PER_ROOM
  PER_PERSON
  PER_NIGHT
  PER_DAY
  PER_HOUR
  PER_TRIP
  PER_SERVICE
  PACKAGE_TOTAL

  @@schema("catalog")
}

/// Refundability foundation (Step 1.8B §13) — минимальная явная семантика,
/// согласованная с существующей cancellation-архитектурой; engine — 1.8D.
/// NULL = не заявлено (legacy).
enum Refundability {
  REFUNDABLE
  NON_REFUNDABLE

  @@schema("catalog")
}

/// Pricing mode Rate Plan (Step 1.8B §17, Universal Pricing §9):
///  - FIXED — нормальная цена (base/fixed);
///  - PRICE_ON_REQUEST — явное inquiry-only состояние плана (НЕ inferred from null).
enum RatePlanPricingMode {
  FIXED
  PRICE_ON_REQUEST

  @@schema("catalog")
}

/// Коммерческое состояние Rate Plan (Step 1.8B §24): ACTIVE — действующий;
/// ARCHIVED — коммерчески снят (soft; данные сохраняются, история не обрывается).
/// Публикация Rate Plan НЕ отдельный lifecycle: eligibility наследуется из
/// родительской цепочки (Product PUBLISHED + ServiceUnit PUBLISHED если attached).
enum RatePlanStatus {
  ACTIVE
  ARCHIVED

  @@schema("catalog")
}

/// Soft коммерческое состояние периода (Step 1.8C §45): ACTIVE — действует;
/// ARCHIVED — коммерчески снят (soft, как RatePlanStatus; resolver игнорирует;
/// delete-safety — history Restrict, физическое удаление запрещено).
enum CommercialPeriodStatus {
  ACTIVE
  ARCHIVED

  @@schema("catalog")
}

/// Коммерческий вид периода (Step 1.8C §12/§13, DD-026 §3.6):
///  - PERIOD — сезонный/явный диапазон (narrower выигрывает у более широкого);
///  - DATE_OVERRIDE — точная дата (startDate == endDate), самый высокий приоритет.
enum CommercialPeriodKind {
  PERIOD
  DATE_OVERRIDE

  @@schema("catalog")
}

/// Scope коммерческого ограничения (Step 1.8D §6):
///  - PERIOD — привязано к конкретному CommercialPeriod (restriction «едет» на
///    resolved period: специфичность наследуется от периода 1.8C, НЕ своя);
///  - DATE — точная сервисная дата (startDate == endDate, date-only UTC).
/// Tariff-base факты живут в Tariff.restrictions (1.8B) — отдельного TARIFF-
/// scope в этом entity НЕТ (единый authority на каждом уровне).
enum CommercialRestrictionScope {
  PERIOD
  DATE

  @@schema("catalog")
}

/// Тип коммерческого ограничения (Step 1.8D §5, минимальный типизированный
/// набор; расширяется аддитивно):
///  - STOP_SELL — даты не продаются (price/availability НЕ трогаются); DATE-only;
///  - MIN_STAY — минимальная длительность услуги (service-days; категория
///    проецирует как ночи для accommodation);
///  - ADVANCE_BOOKING — минимальный lead time (date-only дни, UTC);
///  - CLOSED_TO_ARRIVAL — запрет заезда/начала в даты;
///  - CLOSED_TO_DEPARTURE — запрет выезда/окончания в даты.
enum CommercialRestrictionType {
  STOP_SELL
  MIN_STAY
  ADVANCE_BOOKING
  CLOSED_TO_ARRIVAL
  CLOSED_TO_DEPARTURE

  @@schema("catalog")
}

/// Soft lifecycle коммерческого ограничения (как Tariff/Period): ACTIVE —
/// действует; ARCHIVED — снято (resolver игнорирует; delete-safety — history
/// Restrict; физическое удаление запрещено).
enum CommercialRestrictionStatus {
  ACTIVE
  ARCHIVED

  @@schema("catalog")
}

enum ProductType {
  TOUR
  HOTEL
  SANATORIUM
  FLIGHT
  TRAIN
  EXCURSION
  GUIDE
  TRANSFER
  PHOTOGRAPHER

  @@schema("catalog")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE

  @@schema("catalog")
}

/// Жизненный цикл Category Schema (Step 1.1): DRAFT → ACTIVE → DEPRECATED.
/// ACTIVE — валидация продуктов категории; одновременно одна ACTIVE на категорию.
enum CategorySchemaStatus {
  DRAFT
  ACTIVE
  DEPRECATED

  @@schema("catalog")
}

/// Тип медиа-файла Product (Step 1.2). На шаге реализуются только изображения;
/// VIDEO остаётся capability/configuration будущего pipeline (videoAllowed в Category Schema).
enum MediaType {
  IMAGE
  VIDEO

  @@schema("catalog")
}

/// Lifecycle медиа (Step 1.2, согласован с Product lifecycle).
/// DRAFT — загружено/заменено, ещё НЕ опубликовано (не появляется в public read);
/// PUBLISHED — видно в public read (прошло разрешённый publish transition);
/// ARCHIVED — удалено из публичного контура (soft delete / исторический asset).
/// Invariant: физическая загрузка файла != публикация файла.
enum MediaStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("catalog")
}

/// Moderation workflow (Step 1.4): статус submission Product на модерацию.
/// SUBMITTED → (assign) → IN_REVIEW → APPROVED | REJECTED | CHANGES_REQUESTED.
/// Решение всегда относится к конкретному submission/productVersion (snapshot).
enum ModerationSubmissionStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED

  @@schema("catalog")
}

/// Product — единственный владелец: Catalog Center. Продуктовые данные
/// никогда не копируются в Order/Booking (только productId).
///
/// Step 1.1 (Category Schema foundation): Product остаётся ОДНОЙ универсальной
/// сущностью для всех категорий туристических услуг. categoryId + attributes
/// (валидированные по ACTIVE Category Schema) добавляют category-specific данные
/// без создания отдельных Product-сущностей/доменов на категорию.
model Product {
  id          String        @id @default(uuid())
  code        String        @unique // PRD-00000001
  type        ProductType
  title       String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)
  version     Int           @default(1)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   String?
  updatedBy   String?

  // Category Schema foundation (Step 1.1): категория + снапшот версии schema,
  // по которой валидировались attributes (не меняет молча смысл Product при
  // изменении Category Schema) + сами attributes (JSONB, валидированный).
  categoryId        String?
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categorySchemaId  String?
  categorySchema    CategorySchema? @relation(fields: [categorySchemaId], references: [id], onDelete: SetNull)
  attributes        Json?

  tariffs      Tariff[]
  availability Availability[]
  serviceUnits ServiceUnit[]
  history      ProductHistory[]
  media        ProductMedia[]
  moderation   ModerationSubmission[]
  draft        ProductDraft?
  /// Каналы публикации (REVIEW FIX 3): canonical Product используется Marketplace
  /// и/или Partner Storefront. Пустое множество = ни один публичный канал.
  publicationChannels ProductPublicationChannel[]

  // Владелец-партнёр (RBAC object scope, Step 1.2/1.3): PARTNER управляет только
  // собственными продуктами (product.partnerId == actor.partnerId). Значение
  // устанавливается СЕРВЕРОМ из actor context (никогда не из body/query).
  // null = system/admin-owned (legacy/unowned Product НЕ привязываются к Partner
  // «наугад»). Ссылка по ID без FK — партнёр живёт в crm.*, между схемами FK
  // запрещены (ADR-0001); орфанные ссылки валидируются при установке в сервисе.
  partnerId String?

  @@index([status])
  @@index([categoryId])
  @@index([partnerId])
  @@schema("catalog")
}

/// Канал публикации canonical Product (Step 1.12.1 REVIEW FIX 3/4).
/// Publication channel ≠ lifecycle/status Product: Product PUBLISHED может быть
/// виден только в выбранных каналах (или ни в одном). Один Product никогда не
/// копируется для канала — здесь только разрешение показа в контексте канала.
/// Default при создании Product — MARKETPLACE (обратная совместимость);
/// PARTNER_STOREFRONT добавляется явно (own-scope, аудит).
model ProductPublicationChannel {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel   PublicationChannel
  createdAt DateTime @default(now())
  createdById String?

  @@unique([productId, channel])
  @@index([channel])
  @@schema("catalog")
}

/// Категория каталога (Step 1.1). `slug` — стабильный технический идентификатор
/// ("tours", "accommodation"), `title` — отображаемое имя по умолчанию
/// (локализация RU/AZ/EN — отдельный слой, не технический id).
///
/// Step 1.13A: entity time (createdAt/updatedAt) — базовый temporal-контракт.
/// Legacy-строки (канонический seed до миграции) могут иметь NULL createdAt
/// (историческое значение неизвестно) — NULL = LEGACY UNKNOWN, без fake backfill.
model Category {
  id       String         @id @default(uuid())
  code     String         @unique // CAT-00000001
  slug     String         @unique // стабильный технический id: "tours", "accommodation"
  title    String         // display name по умолчанию (локализация отдельно)
  status   CategoryStatus @default(ACTIVE)
  parentId String?
  parent   Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]     @relation("CategoryTree")

  schemas  CategorySchema[]
  products Product[]

  createdAt DateTime?
  updatedAt DateTime? @updatedAt

  @@schema("catalog")
}

/// Category Schema (Step 1.1) — версионируемая конфигурация категории.
/// Позволяет категории определять: attribute definitions (обязательность, тип,
/// enum/options, searchable/filterable), availability/tariff requirements,
/// media requirements (Step 1.2, пока только конфигурация) и секции PDP.
/// Один универсальный Product + Category + Schema — без отдельных bounded
/// contexts на категорию (Hotel/Tour/Transfer/...).
///
/// Step 1.13A: lifecycle timestamps (activatedAt/deprecatedAt) — РЕАЛЬНЫЕ
/// переходы DRAFT→ACTIVE→DEPRECATED, НЕ updatedAt (temporal taxonomy §3/§4).
/// NULL = milestone ещё не происходил ИЛИ историческое значение неизвестно
/// (legacy ACTIVE schema до миграции). Повторные циклы невозможны (одна ACTIVE
/// на категорию; DEPRECATED не реактивируется) — колонки достаточны, без history.
model CategorySchema {
  id         String               @id @default(uuid())
  categoryId String
  category   Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  version    Int                  @default(1)
  status     CategorySchemaStatus @default(DRAFT)

  /// Определения attribute: [{ key, label, type, required, searchable, filterable, options?, min?, max?, pattern? }]
  attributes Json
  /// Требования availability (дата/слоты) — конфигурация.
  availability Json?
  /// Требования Tariff/Option (обязательные опции и т.п.) — конфигурация.
  tariffRules Json?
  /// Требования media для Step 1.2: minImages/maxImages/primaryImageRequired/allowedMediaTypes/videoAllowed.
  mediaRequirements Json?
  /// Логические секции Product Detail Page (overview/gallery/itinerary/...).
  pdpSections Json?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Step 1.13A: момент перехода DRAFT→ACTIVE (реальный lifecycle, не updatedAt).
  activatedAt DateTime?
  /// Step 1.13A: момент перехода ACTIVE→DEPRECATED (реальный lifecycle, не updatedAt).
  deprecatedAt DateTime?

  products Product[]

  @@unique([categoryId, version])
  @@index([status])
  @@schema("catalog")
}

/// Tariff — canonical Rate Plan foundation (Step 1.8B, DD-024; Universal Pricing §1/§17).
///
/// Канонический коммерческий граф: Product → ServiceUnit → Tariff/Rate Plan →
/// CommercialPeriod (1.8C, НЕ реализован). НЕ создаётся второй RatePlan-концепт.
///
///  - name — Seller-определённое название verbatim (только trim);
///  - price/currency/validFrom/validTo — LEGACY base/fixed price (ДО 1.8C);
///    после 1.8C при наличии применимых CommercialPeriod фактов authoritative —
///    period price; иначе legacy price = base/FIXED fallback (STRICT REVIEW §50);
///  - validFrom/validTo — коммерческая/booking validity window, НЕ stay-период
///    (не переинтерпретировать как CommercialPeriod);
///  - serviceUnitId — каноническая привязка к ServiceUnit (additive, nullable,
///    legacy Product-only тарифы остаются валидными; сервер валидирует
///    unit.productId == tariff.productId и ownership);
///  - priceBasis — одиночный семантический тег; category-allowlist через
///    CategorySchema.tariffRules.allowedBases;
///  - pricingMode FIXED/PRICE_ON_REQUEST — явное inquiry-only состояние
///    (missing price ≠ PRICE_ON_REQUEST);
///  - inclusions/restrictions — структурированные metadata foundations
///    (enforcement/engine — 1.8D);
///  - status ACTIVE/ARCHIVED — коммерческое состояние (не moderation).
///
/// Никаких CommercialPeriod/calendar/resolver/availability-полей (1.8C/1.8D).
model Tariff {
  id        String   @id @default(uuid())
  code      String   @unique // TRF-00000001
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Канонический ServiceUnit-аттач (Step 1.8B §6). NULL — legacy Product-only.
  serviceUnitId String?
  serviceUnit   ServiceUnit? @relation(fields: [serviceUnitId], references: [id], onDelete: SetNull)
  name      String
  price     Decimal  @db.Decimal(12, 2)
  currency  String   @default("USD")
  /// LEGACY booking/commercial validity window — НЕ stay-period (см. выше).
  validFrom DateTime?
  validTo   DateTime?
  priceBasis PriceBasis?
  refundability Refundability?
  pricingMode   RatePlanPricingMode @default(FIXED)
  status        RatePlanStatus      @default(ACTIVE)
  /// Category-driven inclusions foundation (напр. mealPlan/includedServices).
  inclusions Json?
  /// Restrictions metadata foundation (minStay/advanceBooking/...); engine — 1.8D.
  restrictions Json?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  /// @default(now()) — только для additive-миграции существующих legacy-строк;
  /// фактическое значение поддерживает @updatedAt (как остальные Catalog-модели).
  updatedAt DateTime @updatedAt @default(now())

  history TariffHistory[]
  periods CommercialPeriod[]
  commercialRestrictions CommercialRestriction[]

  @@index([productId])
  @@index([serviceUnitId])
  @@index([status])
  @@schema("catalog")
}

/// PHASE 1 STEP 1.8C — CommercialPeriod (period pricing & period availability
/// foundation; DD-026/DD-027, Universal Pricing §1/§5/§30).
///
/// Bounded service-date commercial rule под canonical Rate Plan (Tariff):
///  - kind: PERIOD (сезонный/явный диапазон) | DATE_OVERRIDE (точная дата);
///  - date-only inclusive range: startDate <= serviceDate <= endDate
///    (midnight-UTC, date-only семантика; time-slot/departure — гейт 2.8A);
///  - dayOfWeek — условие ВНУТРИ периода (DD-026 §3.6): период с условием
///    специфичнее «голого» периода того же диапазона; НЕ отдельный слой;
///  - price: периодная цена (bindable при FIXED; POR-планы НЕ могут иметь
///    числовые period price — §35); валюта наследуется из Tariff (одна
///    canonical валюта на Rate Plan, §10 — НЕ дублируется здесь);
///  - sellable: period availability факт (price ≠ availability; stop-sell ≠
///    удаление цены; канонический inventory — Availability/Reservation, §19);
///  - precedence (DD-026): DATE_OVERRIDE > PERIOD (уже диапазон выигрывает) >
///    DAY_OF_WEEK-условие > сезон/base PERIOD > FIXED base; overlapping
///    same-priority → 422 на write;
///  - lifecycle: soft ACTIVE/ARCHIVED (как Tariff); физическое удаление
///    заблокировано (history Restrict — delete-safety §45);
///  - version-CAS (lost-update §47); audit: CommercialPeriodHistory + Security.
model CommercialPeriod {
  id   String @id @default(uuid())
  code String @unique // CPR-00000001

  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  kind      CommercialPeriodKind @default(PERIOD)
  startDate DateTime
  endDate   DateTime
  /// Условие внутри периода: 0=Sunday..6=Saturday (JS getUTCDay-совместимо).
  /// Пустой массив = bare период (без условия).
  dayOfWeek Int[]
  /// Периодная цена (Decimal(12,2), наследует валюту Tariff).
  price Decimal @db.Decimal(12, 2)
  /// Периодная sellability (stop-sell): false = даты периода не продаются.
  sellable Boolean @default(true)
  /// Soft commercial lifecycle (как Tariff): ACTIVE — действует, ARCHIVED —
  /// коммерчески снят (resolver игнорирует; данные/история сохраняются).
  status CommercialPeriodStatus @default(ACTIVE)

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history CommercialPeriodHistory[]
  restrictions CommercialRestriction[]

  @@index([tariffId, status])
  @@schema("catalog")
}

/// Журнал аудита CommercialPeriod (audit by default). onDelete Restrict —
/// физическое удаление периода с аудит-историей запрещено (lifecycle = soft
/// archive; delete-safety, как TariffHistory §52).
model CommercialPeriodHistory {
  id       String @id @default(uuid())
  periodId String
  period   CommercialPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  version  Int
  action   String
  from     String?
  to       String?
  fields   Json?
  actorId  String?
  actorName String?
  comment  String?
  createdAt DateTime @default(now())

  @@index([periodId])
  @@schema("catalog")
}

/// PHASE 1 STEP 1.8D — CommercialRestriction (CRS-*): типизированное
/// коммерческое ограничение/override Rate Plan (Catalog owner, DD-026/DD-028).
///
/// Канонический граф: Product → ServiceUnit → Tariff → CommercialPeriod →
/// CommercialRestriction. Три роли (НЕ три authority):
///  - base факты — Tariff.restrictions (1.8B, whitelist-валидированный);
///  - period-scoped override — restriction на CommercialPeriod (scope PERIOD);
///  - date-scoped override — restriction на точную дату (scope DATE).
///
/// Precedence (детерминированный, §7): DATE (1) > PERIOD-attached к resolved
/// period (2) > base Tariff.restrictions (3). createdAt/порядок строк НЕ
/// precedence; same-priority contradiction на write → 422 (как 1.8C overlap).
///
/// - STOP_SELL — DATE-scope only (period stop-sell = CommercialPeriod.sellable,
///   1.8C authority — не дублируется);
/// - MIN_STAY/ADVANCE_BOOKING — value = положительное число;
/// - CLOSED_TO_ARRIVAL/DEPARTURE — presence = блок (value NULL);
/// - ownership: tariffId server-derived; partnerId наследуется через Product
///   (CatalogAccessPolicy); PARTNER — own-scope, коммерческие правки под DRAFT;
/// - lifecycle soft ACTIVE/ARCHIVED; version-CAS; advisory lock на Tariff;
/// - history Restrict — delete-safety, физическое удаление запрещено;
/// - НЕ inventory-счётчик, НЕ price-строка, НЕ второй pricing/availability
///   engine; time-slot/timezone — гейт 2.8A.
model CommercialRestriction {
  id   String @id @default(uuid())
  code String @unique // CRS-00000001

  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  scope CommercialRestrictionScope
  /// PERIOD-scope: обязательная ссылка на CommercialPeriod (ownership
  /// наследуется через Tariff; сервер валидирует принадлежность + ACTIVE).
  commercialPeriodId String?
  commercialPeriod   CommercialPeriod? @relation(fields: [commercialPeriodId], references: [id], onDelete: Cascade)
  /// DATE-scope: точная дата (startDate == endDate, date-only UTC).
  startDate DateTime?
  endDate   DateTime?

  type  CommercialRestrictionType
  /// MIN_STAY/ADVANCE_BOOKING — значение; STOP_SELL/CTA/CTD — NULL (presence).
  value Int?

  status    CommercialRestrictionStatus @default(ACTIVE)
  version   Int                         @default(1)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  archivedAt DateTime?

  history CommercialRestrictionHistory[]

  @@index([tariffId, status])
  @@index([commercialPeriodId])
  @@index([type, status])
  @@schema("catalog")
}

/// Журнал аудита CommercialRestriction (audit by default; onDelete Restrict —
/// физическое удаление restriction с историей запрещено; lifecycle = soft
/// archive, как TariffHistory/CommercialPeriodHistory).
model CommercialRestrictionHistory {
  id   String @id @default(uuid())
  restrictionId String
  restriction   CommercialRestriction @relation(fields: [restrictionId], references: [id], onDelete: Restrict)
  version Int
  action  String
  from    String?
  to      String?
  fields  Json?
  actorId String?
  actorName String?
  comment String?
  createdAt DateTime @default(now())

  @@index([restrictionId])
  @@schema("catalog")
}


/// Журнал аудита Rate Plan (audit by default; без dump inclusions/restrictions в
/// security audit — только refs и lifecycle/коммерческие transition-факты).
/// STRICT REVIEW §52: onDelete Restrict — физическое удаление Rate Plan с
/// аудит-историей запрещено (history не стирается); legacy Product PATCH
/// tariffs-replacement перехватывает → 409 (см. CatalogService).
model TariffHistory {
  id        String   @id @default(uuid())
  tariffId  String
  tariff    Tariff   @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  version   Int
  action    String
  from      String?
  to        String?
  fields    Json?
  actorId   String?
  actorName String?
  comment   String?
  createdAt DateTime @default(now())

  @@index([tariffId])
  @@schema("catalog")
}

model Availability {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tariffId      String?
  date          DateTime
  slotsTotal    Int      @default(0)
  slotsBooked   Int      @default(0)
  slotsReserved Int      @default(0)

  @@unique([productId, tariffId, date])
  @@schema("catalog")
}

/// Lifecycle capacity-hold (Step 2.4, DD-022 closure).
/// HELD — активный hold (считается в slotsReserved); RELEASED — освобождён
/// (release-on-cancel принадлежит owner-step, здесь только состояние).
enum AvailabilityReservationStatus {
  HELD
  RELEASED

  @@schema("catalog")
}

/// Canonical durable capacity reservation/hold (Step 2.4). Owner — Catalog
/// (catalog.*, ADR-0001): Sales НЕ пишет в catalog.Availability напрямую —
/// атомарное резервирование выполняется через CatalogService.reserveAvailability
/// (owner command) в той же PostgreSQL-транзакции, что и Sale completion.
///
/// Инварианты (DD-022 / Step 2.4 §13-17):
///  - один Sale → один hold на (productId, tariffId, date) с quantity;
///  - атомарный last-slot: conditional UPDATE slotsReserved += quantity
///    WHERE slotsTotal - slotsBooked - slotsReserved >= quantity;
///  - rollback транзакции откатывает и hold, и инкремент (reservation НЕ
///    освобождается автоматически после committed Sale + FAILED outbox —
///    OrderRequested может быть retried);
///  - sourceSaleId — кросс-контекстная ссылка (без FK, ADR-0001).
///
/// НЕ Booking (supplier-level) и НЕ Order hold: inventory capacity hold,
/// предшествующий OrderRequested. release/consume — owner-step (2.5+).
model AvailabilityReservation {
  id         String                        @id @default(uuid())
  /// Канонический ID резервации: RSR-00000001 (IdsService, атомарный счётчик).
  code       String                        @unique
  productId  String
  tariffId   String?
  /// Дата услуги (date-only, UTC midnight — та же модель, что у Availability).
  date       DateTime
  quantity   Int                           @default(1)
  /// Ссылка на Sales Sale (без FK). Один Sale → один hold на item.
  sourceSaleId String
  status     AvailabilityReservationStatus @default(HELD)
  createdById String?
  createdAt  DateTime                      @default(now())
  /// Момент release (HELD → RELEASED), если owner-step введёт release.
  releasedAt DateTime?

  @@index([productId, tariffId, date])
  @@index([sourceSaleId])
  @@schema("catalog")
}

/// Seller Commercial / Service Unit (Phase 1 Step 1.8A, DD-025 B).
///
/// Категория → CategorySchema(template) → Product → Service Unit → Tariff (Rate
/// Plan, Step 1.8B). Персистентная Seller-определённая коммерческая/сервисная
/// единица ВНУТРИ Product: НЕ Product, НЕ attributes-JSON, НЕ CategorySchema.
///
/// Инварианты (Step 1.8A §8-§17, DD-025):
///  - Owner: catalog.* (только Catalog пишет; ADR-0001 — сервис-владелец);
///  - Seller-определённое коммерческое имя сохраняется verbatim (TravelHub
///    стандартизирует атрибуты, не названия);
///  - normalized attributes валидируются по CategorySchema-снапшоту
///    (categorySchemaId), наследуемому из Product (не client-forgeable);
///  - ownership partnerId наследуется из Product (server-derived, trusted ref
///    без FK — ADR-0001), immutable;
///  - lifecycle DRAFT → PUBLISHED → ARCHIVED; публикация — staff/ADMIN команда
///    (catalog.service_unit.publish), гейт: родительский Product PUBLISHED
///    (юнит не может сделать неопубликованный Product публично bookable);
///  - import identity foundation: (source, externalKey) — server/trusted
///    контекст (staff/ADMIN), уникальность в реальном ownership scope
///    (partnerId+productId+source+externalKey) — repeated imports reconcile,
///    никогда не дублируют; manual units (source=NULL, externalKey=NULL)
///    законно не имеют external key (NULL не конфликтует в unique index);
///  - никаких price/availability полей в юните (1.8A — structure only);
///  - business code UNI-* генерирует ТОЛЬКО IdsService (атомарный счётчик).
model ServiceUnit {
  id        String   @id @default(uuid())
  /// Канонический бизнес-код: UNI-00000001 (IdsService, атомарный счётчик).
  code      String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Seller-определённое коммерческое название — verbatim (только trim;
  /// case/порядок слов НЕ нормализуются, НЕ переводятся).
  name String

  /// Category/schema-контекст наследуется из Product (snapshot refs):
  ///  - categoryId — категория, в которой создан Product;
  ///  - categorySchemaId — снапшот версии CategorySchema, по которой
  ///    валидированы attributes (изменение schema НЕ переинтерпретирует
  ///    исторические unit-данные).
  categoryId       String?
  categorySchemaId String?
  /// Normalized structured attributes (валидированный JSON, whitelist-ключи
  /// CategorySchema; источник/original value НЕ перезаписывается таксономией).
  attributes Json?

  /// Import identity foundation (DD-025 §17/§18): source — trusted интеграционный
  /// контекст (не произвольный клиентский authority), externalKey — seller-
  /// scoped внешний ключ. NULL для manual units (без fabricated key).
  source      String?
  externalKey String?

  /// Ownership: partnerId из Product (server-derived, без FK — ADR-0001),
  /// immutable после создания.
  partnerId String?

  status      ServiceUnitStatus @default(DRAFT)
  /// Версия строки (informational/аудит, конвенция Product.version): инкремент
  /// на каждое изменение. НЕ является expectedVersion/CAS-механизмом (конвенция
  /// Catalog — как у Product; stale-state защита — через атомарные conditional
  /// updates по status в ServiceUnitService, STRICT REVIEW 1.8A §34/§35).
  version     Int               @default(1)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   String?
  updatedBy   String?

  history ServiceUnitHistory[]
  /// Rate Plans (Step 1.8B): привязка Tariff.serviceUnitId — каноническая,
  /// сервер валидирует unit.productId == tariff.productId + ownership.
  tariffs Tariff[]

  // Import reconcile: внешний ключ уникален в реальном ownership scope
  // (два Seller не коллидят; в пределах Seller+Product+source ключ уникален).
  // NULL source/externalKey (manual) в unique index НЕ конфликтуют (Postgres).
  @@unique([partnerId, productId, source, externalKey])
  @@index([productId])
  @@index([status])
  @@index([partnerId])
  @@schema("catalog")
}

/// Журнал аудита Service Unit (audit by default; без PII — атрибуты не
/// dump'ятся в security audit, только refs и lifecycle-переходы).
model ServiceUnitHistory {
  id        String       @id @default(uuid())
  unitId    String
  unit      ServiceUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  version   Int
  action    String
  from      String?
  to        String?
  fields    Json?
  actorId   String?
  actorName String?
  comment   String?
  createdAt DateTime     @default(now())

  @@index([unitId])
  @@schema("catalog")
}

/// Медиа Product (Step 1.2). Принадлежит Catalog (не отдельный domain).
/// binary-файлы — в Object Storage (S3-compatible), здесь только metadata + storage keys.
/// Три ключа (derivatives): original + large.webp + thumb.webp.
/// Внутренние storage keys НЕ публикуются: API отдаёт signed preview URL (абстракция).
model ProductMedia {
  id           String      @id @default(uuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         MediaType   @default(IMAGE)

  originalStorageKey    String @unique
  largeStorageKey       String
  thumbnailStorageKey   String
  originalFileName      String
  mimeType              String
  size                  Int
  width                 Int?
  height                Int?
  sortOrder             Int    @default(0)
  isPrimary             Boolean @default(false)
  caption               String?
  altText               String?
  status                MediaStatus @default(DRAFT)
  createdById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([productId])
  @@index([status])
  // DB-level invariant (review fix): partial unique index — для одного Product
  // ФИЗИЧЕСКИ невозможно иметь более одного isPrimary=true, даже при concurrent
  // writes (раньше инвариант гарантировался только application-транзакцией).
  @@unique([productId], where: { isPrimary: true }, map: "ProductMedia_one_primary_per_product")
  @@schema("catalog")
}

/// Content change proposal (Step 1.4 review fix): draft/version N+1 для PUBLISHED Product.
/// Live Product остаётся approved N (published); PARTNER готовит изменения контента N+1
/// в ОТДЕЛЬНОЙ строке (НЕ второй Product, без нового PRD-* кода). media N+1 стейджится
/// как DRAFT media у того же Product. Одновременно один draft на Product (unique productId).
///
/// Инварианты:
///  - live approved N не изменяется, пока существует draft (public N остаётся published);
///  - draft.version инкрементируется на каждую правку — submission фиксирует проверяемую
///    ревизию; approve применяет draft к live (version N+1) и удаляет draft;
///  - reject/request_changes НЕ трогают live N и НЕ удаляют draft (PARTNER продолжает правки).
model ProductDraft {
  id          String   @id @default(uuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// Категория + схема-снапшот черновика (валидируется на PATCH черновика).
  categoryId        String?
  categorySchemaId  String?
  attributes        Json?
  /// Тарифы N+1 (JSON payload; применяются на approve — заменяют live tariffs).
  tariffs     Json?
  /// Ревизия черновика: 1,2,3… на каждую правку PARTNER-а.
  version     Int      @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("catalog")
}

/// Moderation submission (Step 1.4) — Product review process. Moderation НЕ
/// становится владельцем Product: решение относится к immutable snapshot/version,
/// а фактический publish transition выполняет CatalogService (controlled command).
///
/// Инварианты:
///  - snapshot immutable после submit (JSON-копия проверяемой версии, без storage
///    secrets/ключей — только поля + media metadata);
///  - для одного Product физически не более одной АКТИВНОЙ submission
///    (SUBMITTED или IN_REVIEW) — ЕДИНЫЙ partial unique index по isActiveSubmission
///    (Step 1.4 review fix: два раздельных индекса по status позволяли держать одну
///    SUBMITTED И одну IN_REVIEW одновременно);
///  - решение фиксируется CAS-переходом (только одно финальное решение побеждает).
model ModerationSubmission {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Проверяемая версия Product (snapshot). Решение относится к ней, а не к live row.
  productVersion Int
  /// Для change proposal (PUBLISHED): ревизия ProductDraft, проверяемая этой submission.
  /// null — для обычной submission нового Product (DRAFT → COMPLETE).
  draftVersion    Int?
  submittedById   String?
  submittedByUsername String?
  submittedAt     DateTime @default(now())
  status          ModerationSubmissionStatus @default(SUBMITTED)
  /// Managed-флаг «активная submission» (SUBMITTED/IN_REVIEW). Устанавливается
  /// атомарно в тех же переходах, что и status. DB-level единый инвариант — partial
  /// unique index ниже (шаблон тот же, что и ProductMedia.isPrimary).
  isActiveSubmission Boolean @default(false)
  assignedModeratorId String?
  assignedModeratorUsername String?
  reviewStartedAt DateTime?
  decidedAt       DateTime?
  reasonCode      String?
  comment         String?
  /// Immutable JSON snapshot проверяемой версии (fields + category/schema ref +
  /// attributes + tariffs + availability + media metadata, БЕЗ storage keys).
  snapshot        Json
  previousSubmissionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@index([isActiveSubmission])
  @@index([submittedAt])
  @@index([assignedModeratorId])
  // ЕДИНЫЙ DB-level инвариант активной submission (Step 1.4 review fix): для одного
  // Product физически не более одной строки с isActiveSubmission=true, независимо от
  // того SUBMITTED это или IN_REVIEW. Апп-уровень тоже проверяет внутри tx.
  @@unique([productId], where: { isActiveSubmission: true }, map: "ModerationSubmission_one_active_per_product")
  @@schema("catalog")
}

/// Публичная идентичность продавца на Marketplace (Phase 1 Step 1.11).
/// ОТДЕЛЬНАЯ projection от crm.Partner: marketplace НИКОГДА не публикует raw CRM
/// Partner (legalName/taxId/phone/email/website/socials/address/notes).
///
/// Поля: только seller-safe данные + controlled visibility. Даже PUBLIC_BRAND не
/// раскрывает контакты/юр. данные автоматически. Каталог владеет этой проекцией
/// (catalog.* — собственная схема); CRM Partner остаётся CRM-owned; сюда пишет
/// ТОЛЬКО Catalog (события PartnerCreated + детерминированный backfill).
///
/// status — публичное состояние профиля: APPROVED (виден согласно visibilityMode)
/// или HIDDEN (идентичность скрыта модератором; консервативный fallback — вообще
/// не показывать продавца, не «anonymous label»). Изменения контента/видимости
/// идут ТОЛЬКО через PublicSellerProfileProposal (moderated, no silent overwrite).
enum SellerVisibilityMode {
  ANONYMOUS
  VERIFIED_ALIAS
  PUBLIC_BRAND

  @@schema("catalog")
}

/// Публичное состояние PublicSellerProfile (Step 1.11 §15, проекция на профиль).
enum SellerProfileStatus {
  APPROVED
  HIDDEN

  @@schema("catalog")
}

/// Lifecycle предложения изменения публичной идентичности (Step 1.11 §15):
/// PARTNER предлагает, MODERATOR решает. Полный lifecycle модерации — здесь.
enum SellerProposalStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED

  @@schema("catalog")
}

/// Жизненный цикл Partner Storefront (Step 1.12.1):
///  - DRAFT    — создана явной командой PARTNER, публично НЕ существует;
///  - ACTIVE   — публична (появляется в public контуре);
///  - INACTIVE — деактивирована (публично НЕ существует, запись сохраняется).
/// Создание витрины НЕ делает её публичной автоматически; deactivate НЕ удаляет.
/// Повторные activate/deactivate детерминированы (no-op при том же состоянии).
enum StorefrontStatus {
  DRAFT
  ACTIVE
  INACTIVE

  @@schema("catalog")
}

/// Коммерческий entitlement Storefront (Step 1.12.1 REVIEW FIX 2). Storefront —
/// платный SaaS-продукт TravelHub, НЕ бесплатная capability любого PARTNER:
/// публичная activation требует `entitlementStatus = ACTIVE`.
///  - NONE      — entitlement не предоставлен (default; DRAFT можно вести, публикация нельзя);
///  - ACTIVE    — публикация разрешена;
///  - SUSPENDED — приостановлен (публичная витрина скрывается, данные сохраняются);
///  - EXPIRED   — истёк (публичная витрина скрывается, данные сохраняются).
/// На Step 1.12.1 реального Billing/PSP НЕТ: это минимальный entitlement-ready
/// контракт, который ПОЗЖЕ станет authoritative от Billing domain (через события).
/// Сейчас управляется ЯВНОЙ операционной командой (ADMIN) — без фиктивных
/// Payment/Invoice. НЕ заменяется User.status / crm.Partner.status / Product.status.
enum StorefrontEntitlementStatus {
  NONE
  ACTIVE
  SUSPENDED
  EXPIRED

  @@schema("catalog")
}

/// Каналы публикации canonical Catalog.Product (Step 1.12.1 REVIEW FIX 3/4).
/// Publication channel ОТДЕЛЁН от lifecycle/status Product: один Product может
/// быть опубликован в любом подмножестве каналов (или ни в одном). Копии Product
/// НЕ создаются — канал это только разрешение показа canonical Product в контексте.
enum PublicationChannel {
  MARKETPLACE
  PARTNER_STOREFRONT

  @@schema("catalog")
}

/// Публичный профиль продавца (Step 1.11). partnerId — ссылка на crm.Partner без
/// FK (межсхемные FK запрещены). publicId (SELL-*) — стабильный публичный
/// идентификатор, НЕ partnerId: по partnerId публичный контур не ищет.
model PublicSellerProfile {
  id        String   @id @default(uuid())
  /// Публичный идентификатор продавца (SELL-*), генерирует Catalog.
  publicId  String   @unique
  /// Ссылка на crm.Partner (без FK). Каноническая связь: один профиль на Partner.
  partnerId String   @unique
  status    SellerProfileStatus @default(APPROVED)
  /// Консервативный default: ANONYMOUS. Переключение — только через moderated
  /// proposal (PARTNER не может сам переключить себя в PUBLIC_BRAND/VERIFIED_ALIAS).
  visibilityMode SellerVisibilityMode @default(ANONYMOUS)

  /// Approved seller-safe поля (применяются из APPROVED proposal, никогда raw CRM).
  publicDisplayName String?
  publicDescription String?
  publicLogoMediaId String?
  /// AUTHORITATIVE geography (FIX 2): только коды, никогда locale-значения.
  /// countryCode — системная identity из crm.Partner (копируется при создании/
  /// approve; proposal НЕ может её подменить). cityCode — код из канонического
  /// справочника Catalog (должен принадлежать стране партнёра). Локализация
  /// (RU/AZ/EN display label) — обязанность клиента по кодам, не хранится здесь.
  countryCode String?
  cityCode    String?

  /// Партнёр прошёл проверку (onboarding approve / существующий ACTIVE Partner).
  verified Boolean @default(true)
  /// Дата вступления (memberSince) — момент создания профиля.
  memberSince DateTime @default(now())
  /// Время/автор последнего утверждённого изменения видимости/контента.
  approvedAt DateTime?
  approvedById String?
  approvedByUsername String?

  /// CAS-версия (stale-решения отклоняются 409).
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals PublicSellerProfileProposal[]

  @@index([status])
  @@index([visibilityMode])
  @@schema("catalog")
}

/// Предложение изменения публичной идентичности (Step 1.11 §16): Published N →
/// proposal N+1 → moderation → approve → public N+1. No silent overwrite: поля
/// профиля меняются ТОЛЬКО при APPROVED proposal.
///
/// PARTNER не может self-approve и не может сам запросить PUBLIC_BRAND как
/// немедленное переключение — requestedVisibilityMode ограничен VERIFIED_ALIAS;
/// решение PUBLIC_BRAND принимает MODERATOR (approve_brand).
model PublicSellerProfileProposal {
  id        String   @id @default(uuid())
  code      String   @unique // SPP-00000001
  profileId String
  profile   PublicSellerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  status    SellerProposalStatus @default(DRAFT)
  /// CAS-версия предложения (stale-редактирование/решения → 409).
  version   Int @default(1)

  /// Запрашиваемые PARTNER-ом поля (только seller-safe).
  /// Страна в предложении ОТСУТСТВУЕТ: country — системная identity crm.Partner,
  /// proposal не может подменить её locale-значением. Город — код из
  /// канонического справочника (cityCode), валидируется по стране партнёра.
  requestedDisplayName String?
  requestedDescription String?
  requestedLogoMediaId String?
  requestedCityCode    String?
  /// Что PARTNER запрашивает: только VERIFIED_ALIAS (свой alias). PUBLIC_BRAND
  /// устанавливается решением MODERATOR (поле approvedVisibilityMode).
  requestedVisibilityMode SellerVisibilityMode @default(VERIFIED_ALIAS)

  /// Решение MODERATOR: какой режим фактически утверждён (alias или brand).
  approvedVisibilityMode SellerVisibilityMode?
  submittedById String?
  submittedByUsername String?
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewedById String?
  reviewedByUsername String?
  decisionReason String?
  decisionComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([profileId])
  @@schema("catalog")
}

/// Partner Storefront (Phase 1 Step 1.12.1) — персональная публичная витрина
/// PARTNER. Catalog-owned (как и весь catalog.*). НЕ является вторым Catalog /
/// копией Product: витрина ТОЛЬКО ссылается на существующие catalog.Product
/// (один Product используется и Marketplace, и Storefront — никаких
/// storefront-specific копий).
///
/// Инварианты:
///  - максимум ОДНА витрина на Partner (partnerId @unique, DB-level);
///  - slug normalized/URL-safe/immutable, @unique (race → controlled 409);
///  - lifecycle DRAFT → ACTIVE → INACTIVE; создание НЕ публикует автоматически;
///    DRAFT/INACTIVE публично не существуют (public контур фильтрует status);
///  - deactivate НЕ удаляет; повторные activate/deactivate детерминированы;
///  - partnerId — ссылка на crm.Partner БЕЗ FK (межсхемные FK запрещены ADR-0001);
///    каноническая связь: один storefront на Partner; здесь НЕ копируется CRM
///    (name/email/phone/юр. данные остаются в crm.Partner);/// - businessName/tagline/description проходят anti-disintermediation до активации;
/// - business identity (Step 1.12.2): businessName + контакты — Storefront-owned
///   (это платный SaaS-сайт PARTNER), НЕ привязаны к PublicSellerProfile;
///   Marketplace показывает ТОЛЬКО Step 1.11 seller projection — storefront
///   businessName/контакты в Marketplace не попадают;
/// - countryCode — системная identity из crm.Partner (locale-независима, НЕ
///   устанавливается PARTNER); cityCode — код канонического справочника Catalog
///   и обязан принадлежать стране витрины;
/// - lifecycle timestamps: activatedAt/deactivatedAt — реальные бизнес-переходы
///   (НЕ updatedAt), + actor (activatedById/deactivatedById).
model PartnerStorefront {
  id        String   @id @default(uuid())
  /// Стабильный публичный код (SF-00000001), генерирует Catalog (IdsService).
  code      String   @unique
  /// Ссылка на crm.Partner (без FK). Одна витрина на Partner.
  partnerId String   @unique
  /// Публичный slug: normalized, URL-safe, immutable после создания.
  slug      String   @unique
  status    StorefrontStatus @default(DRAFT)
  /// Коммерческий entitlement (REVIEW FIX 2). PUBLIC activation требует ACTIVE.
  /// SUSPENDED/EXPIRED скрывают публичную витрину без удаления данных.
  entitlementStatus StorefrontEntitlementStatus @default(NONE)
  /// Storefront business identity (Step 1.12.2 §3): ИМЯ бизнеса на платном
  /// сайте PARTNER. НЕ привязано к seller profile; anti-disintermediation
  /// применяется на запись. В Marketplace контур НЕ попадает.
  businessName String?
  tagline     String?
  description String?
  /// Локаль контента витрины по умолчанию (ru/az/en). НЕ является country code.
  defaultLocale String @default("ru")

  /// География витрины (коды, locale-независимы). countryCode — системная
  /// identity из crm.Partner (записывается сервисом, НЕ из body); cityCode —
  /// код справочника Catalog, обязан принадлежать countryCode.
  countryCode String?
  cityCode    String?

  /// Structured business contacts (Step 1.12.2 §4) — публикуются ТОЛЬКО в
  /// Storefront-контексте (ACTIVE + entitlement ACTIVE). В Marketplace/CRM/
  /// PublicSellerProfile не попадают. Валидация: формат email/phone/URL.
  publicPhone  String?
  publicEmail  String?
  websiteUrl   String?
  whatsapp     String?
  socialLinks  Json?

  /// Branding (Step 1.12.2 §5): hero heading/subheading + безопасный theme
  /// preset (whitelist). Arbitrary CSS/JS/HTML запрещён. Логотип/hero-изображения
  /// — отдельная модель StorefrontMedia (private storage, controlled upload).
  heroHeading    String?
  heroSubheading String?
  themePreset    String @default("default")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Моменты РЕАЛЬНЫХ lifecycle-переходов (не updatedAt).
  activatedAt   DateTime?
  deactivatedAt DateTime?
  createdById   String?
  updatedById   String?
  activatedById   String?
  deactivatedById String?

  /// Storefront-owned media (logo/hero) — private storage, controlled upload.
  media StorefrontMedia[]

  @@index([status])
  @@schema("catalog")
}

/// Тип Storefront-медиа: LOGO (квадратный логотип) / HERO (баннер витрины).
/// Один файл на kind (replace-семантика) — unique [storefrontId, kind].
enum StorefrontMediaKind {
  LOGO
  HERO

  @@schema("catalog")
}

/// Storefront-owned media (Step 1.12.2 §5/§6). ProductMedia семантически не
/// подходит (это media продукта Marketplace), поэтому Storefront имеет собственный
/// media-контракт: private storage, controlled upload (MIME/size), стабильный
/// public URL только при ACTIVE + entitlement ACTIVE витрине; staged/private
/// объекты не публичны; storage keys/bucket/credentials в public JSON отсутствуют.
/// Media не публикуется автоматически при upload — публичность определяется
/// состоянием витрины (public predicate), а не статусом самого файла.
model StorefrontMedia {
  id         String   @id @default(uuid())
  storefrontId String
  kind       StorefrontMediaKind
  /// Private storage key (никогда не публикуется наружу).
  storageKey String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  originalFileName String
  createdAt  DateTime @default(now())
  createdById String?

  storefront PartnerStorefront @relation(fields: [storefrontId], references: [id])

  @@unique([storefrontId, kind])
  @@index([storefrontId])
  @@schema("catalog")
}

/// Behavioral event types public Storefront (Step 1.12.3). НЕ business domain
/// events (outbox) и НЕ AuditLog: это анонимная поведенческая телеметрия
/// посетителя. Marketplace behavioral events (1.13B) — отдельный будущий шаг,
/// эти имена не конфликтуют (namespace `STOREFRONT_*`).
enum StorefrontBehavioralEventType {
  STOREFRONT_VIEWED
  STOREFRONT_PRODUCT_IMPRESSION
  STOREFRONT_PRODUCT_VIEWED
  STOREFRONT_CONTACT_CLICKED

  @@schema("catalog")
}

/// Acquisition/source context (Step 1.12.3 §1/§16). Отличается от publication
/// channel: publication — где Product разрешён, acquisition — через какой
/// пользовательский контекст возникло конкретное взаимодействие. Для Storefront
/// events источник сервером фиксируется как PARTNER_STOREFRONT (endpoint
/// storefront-scoped; DIRECT — только при будущем referral/entry-контракте,
/// сейчас не симулируется). MARKETPLACE — зарезервирован для Step 1.13B.
enum AcquisitionSource {
  MARKETPLACE
  PARTNER_STOREFRONT
  DIRECT

  @@schema("catalog")
}

/// Privacy-safe behavioral event (Step 1.12.3 §4/§5/§10/§22/§23).
///  - eventId — client-generated UUID: dedup (unique); повторная доставка того же
///    eventId не удваивает будущие метрики;
///  - occurredAt — фактическое UTC-время действия пользователя (client), окно
///    clock-skew ограничено сервером; receivedAt — отдельная server-семантика;
///  - storefrontId/productId — canonical IDs, резолвятся сервером из slug'ов
///    (клиент не может forged identity);
///  - sessionId — opaque non-PII anonymous session; без fingerprinting,
///    без cross-device identity graph, без raw IP;
///  - acquisitionSource — authoritative server context (PARTNER_STOREFRONT);
///  - payload — строгий per-eventType whitelist (contactType/platform/placement),
///    НИКОГДА contact values / email / phone / URL / raw IP / tokens;
///  - createdById НЕТ: события анонимны (AuditLog ≠ behavioral analytics).
///  НЕ FK между bounded contexts (ADR-0001): storefrontId/productId — ссылки
///  по ID без relations (таблица в catalog, но события не lifecycle-связаны).
model StorefrontBehavioralEvent {
  id              String   @id @default(uuid())
  eventId         String   @unique
  eventType       StorefrontBehavioralEventType
  occurredAt      DateTime
  receivedAt      DateTime @default(now())
  storefrontId    String
  productId       String?
  sessionId       String
  acquisitionSource AcquisitionSource
  locale          String
  path            String
  payload         Json?

  @@index([storefrontId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([productId])
  @@index([sessionId])
  @@index([acquisitionSource, occurredAt])
  @@schema("catalog")
}

/// Behavioral event types public Marketplace (Phase 1 Step 1.13B). Тот же
/// namespace-паттерн, что у Storefront (Step 1.12.3), но MARKETPLACE_*:
///  - MARKETPLACE_VIEWED             — публичная Marketplace home реально открыта;
///  - MARKETPLACE_PRODUCT_IMPRESSION — карточка Product реально отрисована в grid
///    (rendered-card семантика, как у Storefront; viewport — deferred);
///  - MARKETPLACE_PRODUCT_VIEWED     — открыт публичный Marketplace PDP;
///  - MARKETPLACE_SEARCH_PERFORMED   — пользователь выполнил committed search
///    (submit/committed URL state; НЕ каждый keystroke);
///  - MARKETPLACE_CATEGORY_VIEWED    — открыта публичная category surface;
///  - MARKETPLACE_FILTER_APPLIED     — применён фильтр (whitelist key+value);
///  - MARKETPLACE_SORT_CHANGED       — изменена сортировка (whitelist enum);
///  - MARKETPLACE_CTA_CLICKED        — клик по реальному CTA Marketplace PDP
///    (намерение; НЕ Order/Booking/Payment — их нет).
enum MarketplaceBehavioralEventType {
  MARKETPLACE_VIEWED
  MARKETPLACE_PRODUCT_IMPRESSION
  MARKETPLACE_PRODUCT_VIEWED
  MARKETPLACE_SEARCH_PERFORMED
  MARKETPLACE_CATEGORY_VIEWED
  MARKETPLACE_FILTER_APPLIED
  MARKETPLACE_SORT_CHANGED
  MARKETPLACE_CTA_CLICKED

  @@schema("catalog")
}

/// Privacy-safe Marketplace behavioral event (Phase 1 Step 1.13B). Та же
/// semantic discipline, что у StorefrontBehavioralEvent (Step 1.12.3):
///  - eventId — client UUID, dedup (unique); retry не удваивает метрики;
///  - occurredAt — client UTC в clock-skew окне; receivedAt — server;
///  - productId/categoryId — canonical, резолвятся СЕРВЕРОМ из slug'ов через
///    публичные predicates (клиент не может forged identity);
///  - sessionId — opaque non-PII anonymous session (без fingerprinting/cross-
///    device graph/raw IP);
///  - acquisitionSource — server-authoritative MARKETPLACE (клиент не может
///    forged); publication channel продукта источник не меняет;
///  - payload — строгий per-eventType whitelist; search query НЕ хранится raw
///    без privacy guard; НИКОГДА email/phone/URL/contact/токены/User/CRM ids;
///  - createdById НЕТ: анонимная телеметрия, не AuditLog, не outbox.
model MarketplaceBehavioralEvent {
  id              String   @id @default(uuid())
  eventId         String   @unique
  eventType       MarketplaceBehavioralEventType
  occurredAt      DateTime
  receivedAt      DateTime @default(now())
  productId       String?
  categoryId      String?
  sessionId       String
  acquisitionSource AcquisitionSource
  locale          String
  path            String
  payload         Json?

  @@index([eventType, occurredAt])
  @@index([productId, occurredAt])
  @@index([categoryId, occurredAt])
  @@index([sessionId])
  @@index([acquisitionSource, occurredAt])
  @@schema("catalog")
}


/// Журнал аудита Catalog (audit by default).
model ProductHistory {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version   Int
  action    String
  from      String?
  to        String?
  fields    Json?
  actorId   String?
  actorName String?
  comment   String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@schema("catalog")
}

// ─────────────────────────────── crm.* ───────────────────────────────────

enum CustomerType {
  PERSON
  COMPANY

  @@schema("crm")
}

enum EntityStatus {
  ACTIVE
  INACTIVE

  @@schema("crm")
}

/// Customer — единственный владелец: CRM (SSOT клиентских мастер-данных).
/// Order/Booking хранят только customerId.
model Customer {
  id          String       @id @default(uuid())
  code        String       @unique // CUS-00000001
  type        CustomerType @default(PERSON)
  firstName   String?
  lastName    String?
  companyName String?
  email       String       @unique
  phone       String?
  status      EntityStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  contacts    Contact[]
  history     CustomerHistory[]

  @@index([status])
  @@schema("crm")
}

model Contact {
  id         String   @id @default(uuid())
  code       String   @unique // CNT-00000001
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  role       String?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@schema("crm")
}

model Company {
  id     String       @id @default(uuid())
  code   String       @unique // COM-00000001
  name   String
  inn    String?
  status EntityStatus @default(ACTIVE)

  partners  Partner[]
  suppliers Supplier[]

  @@schema("crm")
}

model Partner {
  id        String      @id @default(uuid())
  code      String      @unique // PAR-00000001
  companyId String?
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name      String
  status    EntityStatus @default(ACTIVE)

  // Step 1.10 — authoritative business identifiers for deterministic
  // create-or-link (Partner onboarding). НЕ являются display-полями:
  //  - contactEmail      — канонический ключ INDIVIDUAL (нормализованный email);
  //  - registrationNumber — канонический ключ COMPANY (регистрационный номер);
  //  - taxId             — справочное поле (INN и т.п.), НЕ ключ связи.
  // Partial unique: ровно один Partner на ключ, когда ключ задан (DB-level
  // идемпотентность — retry approve не создаёт duplicate Partner).
  contactEmail       String?
  registrationNumber String?
  taxId              String?
  /// Authoritative country (Step 1.11 FIX 2): системная identity из onboarding
  /// application (2-letter code, e.g. AZ/RU). НЕ display-поле и НЕ locale:
  /// локализованный label вычисляет клиент по коду. Может быть null для legacy
  /// Partner (тогда seller profile без countryCode — консервативно).
  countryCode        String?

  @@unique([contactEmail], where: { contactEmail: { not: null } }, map: "Partner_unique_contactEmail")
  @@unique([registrationNumber], where: { registrationNumber: { not: null } }, map: "Partner_unique_registrationNumber")
  @@schema("crm")
}

model Supplier {
  id        String      @id @default(uuid())
  code      String      @unique // SUP-00000001
  companyId String?
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name      String
  status    EntityStatus @default(ACTIVE)

  @@schema("crm")
}

/// Журнал аудита CRM.
model CustomerHistory {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  action     String
  from       String?
  to         String?
  fields     Json?
  actorId    String?
  actorName  String?
  comment    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@schema("crm")
}

// ─────────────────────────────── order.* ─────────────────────────────────

enum OrderStatus {
  NEW
  IN_PROCESSING
  WAITING_FOR_DATA
  READY_FOR_BOOKING
  SENT_TO_BOOKING
  PARTIALLY_FULFILLED
  FULFILLED
  READY_TO_CLOSE
  CLOSED
  CANCELLED
  PROBLEM
  SUSPENDED

  @@schema("order")
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED

  @@schema("order")
}

enum FulfillmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@schema("order")
}

enum TravelerDataCompleteness {
  INCOMPLETE
  COMPLETE

  @@schema("order")
}

/// Order — единственный владелец: Order Center.
/// customerId — ссылка на CRM (без FK), productId — ссылка на Catalog (без FK).
///
/// Step 2.5 — canonical event-driven creation (OrderRequested consumer):
///  - customerId NULL допустим: internal-assisted flow без CRM-клиента
///    (OrderRequested.customerId честно nullable, Step 2.4 §11);
///  - saleId @unique — DB-level инвариант «один Sale → один Order»
///    (идемпотентность НЕ зависит только от in-process inbox);
///  - frozen commercial snapshot (subtotal/discount/payment terms/acquisition
///    source) копируется ИЗ OrderRequested без пересчёта — downstream
///    Booking/Finance/Documents не зависят от mutable Sales/Catalog state;
///  - cross-schema refs (saleId/quoteId/checkoutId/reservationId) — по ID без
///    FK (ADR-0001).
model Order {
  id            String              @id @default(uuid())
  code          String              @unique // ORD-00000001
  number        String              @unique // TH-2026-000001
  customerId    String? // ссылка на CRM, без FK; NULL — internal assisted flow
  status        OrderStatus         @default(NEW)
  paymentStatus OrderPaymentStatus  @default(UNPAID)
  currency      String              @default("USD")
  amount        Decimal             @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal             @default(0) @db.Decimal(12, 2)
  serviceDate   DateTime?
  version       Int                 @default(1)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     String?
  updatedBy     String?

  // ── Step 2.5 — upstream refs (без FK) + frozen commercial snapshot ──
  /// Один Sale completion → один Order (DB-level инвариант; NULL для
  /// legacy/bootstrap Order).
  saleId                String?    @unique
  saleCode              String?
  quoteId               String?
  checkoutId            String?
  /// Primary catalog.AvailabilityReservation ref (capacity hold, Step 2.4).
  reservationId         String?
  /// ВСЕ catalog.AvailabilityReservation refs этого Sale (один hold на item,
  /// STRICT REVIEW 2.5: multi-item Sale не теряет кардинальность holds).
  reservationIds        Json?
  /// OrderRequested eventId, создавший Order (traceability/idempotency).
  orderRequestedEventId String?
  /// Сумма строк (без скидки) — frozen snapshot из OrderRequested.
  subtotal              Decimal?   @db.Decimal(12, 2)
  /// Snapshot QuoteDiscountType (cross-schema enum → String, честно).
  discountType          String?
  discountValue         Decimal?   @db.Decimal(12, 2)
  discountAmount        Decimal?   @db.Decimal(12, 2)
  /// Payment terms snapshot (Step 2.3B) — immutable commercial facts,
  /// НЕ пересчитываются из текущей конфигурации.
  paymentScheme         String?
  prepaymentType        String?
  prepaymentValue       Decimal?   @db.Decimal(12, 2)
  initialAmount         Decimal?   @db.Decimal(12, 2)
  remainingAmount       Decimal?   @db.Decimal(12, 2)
  /// Acquisition source snapshot (Step 2.5B propagation boundary — не
  /// ре-вычисляется consumer-ом).
  acquisitionSource     String?

  // ── Step 2.5A — Order Temporal Contract (business milestones) ──
  /// Момент подачи/входа заказа в систему (OrderRequested consumer ИЛИ
  /// bootstrap). Server-owned; immutable; NULL = legacy row (до миграции,
  /// без backfill) — НЕ заменяет createdAt (persistence time).
  submittedAt DateTime?
  /// Момент перехода confirm → READY_FOR_BOOKING (OrderReadyForBooking).
  /// Server-owned; immutable (однажды установлен — не перезаписывается).
  confirmedAt DateTime?
  /// Момент перехода cancel → CANCELLED (OrderCancelled). Server-owned;
  /// immutable.
  cancelledAt DateTime?
  /// Момент перехода complete ИЛИ reconcile-реконсиляции → FULFILLED
  /// (OrderFulfilled). Server-owned; immutable.
  fulfilledAt DateTime?
  /// Момент перехода close → CLOSED (OrderClosed). Server-owned; immutable.
  closedAt DateTime?

  items      OrderItem[]
  travelers  OrderTraveler[]
  fulfillments Fulfillment[]
  history    OrderHistory[]

  @@index([status])
  @@index([customerId])
  @@schema("order")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String // ссылка на Catalog, без FK
  productCode String // снапшот канонического кода (PRD-*), не дублирование данных
  title       String
  type        String
  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  amount      Decimal  @db.Decimal(12, 2)
  serviceDate DateTime?

  @@index([orderId])
  @@schema("order")
}

model OrderTraveler {
  id                String                  @id @default(uuid())
  orderId           String
  order             Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId        String?
  firstName         String
  lastName          String
  birthDate         DateTime?
  citizenship       String?
  gender            String?
  passportNumber    String?
  passportExpiry    DateTime?
  dataCompleteness  TravelerDataCompleteness @default(INCOMPLETE)
  version           Int                     @default(1)

  @@index([orderId])
  @@schema("order")
}

model Fulfillment {
  id        String            @id @default(uuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    FulfillmentStatus @default(NOT_STARTED)
  notes     String?

  @@index([orderId])
  @@schema("order")
}

/// Журнал аудита Order (audit by default).
model OrderHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    String
  from      String?
  to        String?
  fields    Json?
  actorId   String?
  actorName String?
  comment   String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@schema("order")
}

// ─────────────────────────────── booking.* ───────────────────────────────

enum BookingStatus {
  NEW
  PREPARING_REQUEST
  SENT_TO_SUPPLIER
  AWAITING_CONFIRMATION
  CONFIRMED
  IN_SERVICE
  COMPLETED
  NEEDS_CLARIFICATION
  SUPPLIER_REJECTED
  CHANGE_REQUESTED
  CANCELLATION_REQUESTED
  CANCELLED
  PROBLEM

  @@schema("booking")
}

enum ReservationStatus {
  HELD
  CONFIRMED
  RELEASED

  @@schema("booking")
}

/// Booking — единственный владелец: Booking Center.
/// Создаётся ТОЛЬКО consumer-ом события BookingRequested (идемпотентно).
model Booking {
  id          String        @id @default(uuid())
  code        String        @unique // BKG-00000001
  orderId     String // ссылка на Order, без FK
  productId   String // ссылка на Catalog, без FK
  status      BookingStatus @default(NEW)
  amount      Decimal       @default(0) @db.Decimal(12, 2)
  serviceDate DateTime?
  /// Step 2.5B: frozen acquisition source, скопированный consumer-ом из Order
  /// (READ-only, ADR-0001) в момент создания Booking. Cross-schema ref — String
  /// (Prisma multiSchema); NULL — legacy Booking до 2.5B (без backfill).
  acquisitionSource String?
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reservations         Reservation[]
  supplierConfirmations SupplierConfirmation[]
  passengers           Passenger[]
  history              BookingHistory[]

  @@index([orderId])
  @@index([status])
  @@schema("booking")
}

model Reservation {
