[TEMPLATE]
# ── TravelHub backend — environment template (NO real secrets) ────────────────
# Copy to `.env` and adjust for your local machine.

# Development / production database — NEVER used by e2e tests.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelhub1"

# E2E test database (isolated). The database NAME MUST END WITH "test"
# (suffix rule, e.g. `travelhub1_test`): e2e globalSetup/setupFiles refuse to
# run otherwise, so destructive e2e can never target the dev/prod DB.
# If unset, tests fall back to travelhub1_test on localhost.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelhub1_test"

PORT=4000
JWT_SECRET=dev-jwt-secret-change-in-prod
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── ProductMedia storage (Phase 1 Step 1.2) — S3-compatible ──────────────────
# Dev: docker compose up -d minio  (см. корневой docker-compose.yml).
# Prod: любой S3-compatible провайдер (MinIO/WASABI/AWS S3) — сменить endpoint/credentials.
# Приватный bucket: binary-файлы хранятся в Object Storage, metadata — в PostgreSQL.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="travelhub-media"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# ── E2E prerequisites (backend/test, `npm run test:e2e`) ─────────────────────
# - PostgreSQL client tools: `psql` must be on PATH (used to drop/create the
#   isolated test DB in e2e.global-setup.ts).
# - E2E стартуют ИЗОЛИРОВАННЫЙ standalone MinIO (test/e2e.minio.ts) с отдельным
#   bucket `travelhub-media-test` на порту 19000 — dev/prod bucket не используется.
# - MinIO binary для e2e скачивается АВТОМАТИЧЕСКИ: version-pinned релиз
#   (MINIO_VERSION в test/e2e.minio.ts) с проверкой SHA-256, кэш в .tools/minio/
#   (gitignored). Ручное копирование minio.exe НЕ требуется — свежий checkout/CI
#   запускается без ручных шагов (нужен сетевой доступ в первый раз).
# - Only ONE e2e run at a time per test database (two concurrent runs would
#   drop each other's database).

# ── WhatsApp integration (M1, milestone «Фундамент») ────────────────────────
# Мастер-промпт §6.3: конфигурация валидируется на старте. ENABLED=true с
# невалидными значениями (нет WHATSAPP_SESSION_PATH / WHATSAPP_AUTH_ENCRYPTION_KEY)
# → fail-closed: приложение не стартует WhatsApp-слой и печатает причину.
# Секреты в репо не хранятся; ключ шифрования — >=32 символов из secret store.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=baileys
WHATSAPP_ROLE=all
WHATSAPP_SESSION_PATH=
WHATSAPP_AUTH_ENCRYPTION_KEY=
WHATSAPP_AUTO_CONNECT=true
WHATSAPP_RECONNECT_ENABLED=true
WHATSAPP_RECONNECT_BASE_DELAY_MS=1000
WHATSAPP_RECONNECT_MAX_DELAY_MS=60000
WHATSAPP_MAX_RECONNECT_ATTEMPTS=10
WHATSAPP_SEND_TIMEOUT_MS=30000
# M2: session lease/fencing — только один инстанс держит lease (CAS-строка),
# self-fencing при потере; heartbeat не больше половины TTL (fail-closed).
WHATSAPP_LEASE_TTL_MS=45000
WHATSAPP_LEASE_HEARTBEAT_MS=15000
# M2: rate-limit GET /whatsapp/qr (скользящее окно per-user; 429 при превышении).
WHATSAPP_QR_RATE_LIMIT_MAX=10
WHATSAPP_QR_RATE_LIMIT_WINDOW_MS=10000
WHATSAPP_IMPORT_HISTORY=false
WHATSAPP_DEFAULT_PHONE_REGION=AZ
# Throttle / circuit breaker (решение владельца №14):
# recipient 1 msg/sec и 20 msg/hour; global 5 msg/sec; burst 10;
# CB: 5 подряд retryable-ошибок → open 60 сек, backoff до 15 мин; очередь до 1000.
WHATSAPP_THROTTLE_PER_RECIPIENT_INTERVAL_MS=1000
WHATSAPP_THROTTLE_PER_RECIPIENT_HOURLY_LIMIT=20
WHATSAPP_THROTTLE_GLOBAL_RATE_PER_SEC=5
WHATSAPP_THROTTLE_BURST_LIMIT=10
WHATSAPP_THROTTLE_CB_FAILURE_THRESHOLD=5
WHATSAPP_THROTTLE_CB_OPEN_MS=60000
WHATSAPP_THROTTLE_CB_MAX_BACKOFF_MS=900000
WHATSAPP_THROTTLE_QUEUE_MAX_SIZE=1000
