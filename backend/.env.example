[TEMPLATE]
# ── TravelHub backend — environment template (NO real secrets) ────────────────
# Copy to `.env` and adjust for your local machine.

# Development / production database — NEVER used by e2e tests.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelhub1"

# E2E test database (isolated). The database NAME MUST END WITH "test"
# (suffix rule, e.g. `travelhub1_test`): e2e globalSetup/setupFiles refuse to
# run otherwise, so destructive e2e can never target the dev/prod DB.
# If unset, tests fall back to travelhub1_test on localhost.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelhub1_test"

PORT=4000
JWT_SECRET=dev-jwt-secret-change-in-prod
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── ProductMedia storage (Phase 1 Step 1.2) — S3-compatible ──────────────────
# Dev: docker compose up -d minio  (см. корневой docker-compose.yml).
# Prod: любой S3-compatible провайдер (MinIO/WASABI/AWS S3) — сменить endpoint/credentials.
# Приватный bucket: binary-файлы хранятся в Object Storage, metadata — в PostgreSQL.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="travelhub-media"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# ── E2E prerequisites (backend/test, `npm run test:e2e`) ─────────────────────
# - PostgreSQL client tools: `psql` must be on PATH (used to drop/create the
#   isolated test DB in e2e.global-setup.ts).
# - E2E стартуют ИЗОЛИРОВАННЫЙ standalone MinIO (test/e2e.minio.ts) с отдельным
#   bucket `travelhub-media-test` на порту 19000 — dev/prod bucket не используется.
# - MinIO binary для e2e скачивается АВТОМАТИЧЕСКИ: version-pinned релиз
#   (MINIO_VERSION в test/e2e.minio.ts) с проверкой SHA-256, кэш в .tools/minio/
#   (gitignored). Ручное копирование minio.exe НЕ требуется — свежий checkout/CI
#   запускается без ручных шагов (нужен сетевой доступ в первый раз).
# - Only ONE e2e run at a time per test database (two concurrent runs would
#   drop each other's database).
