{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": "..",
  "testEnvironment": "<rootDir>/test/e2e-isolated-env.ts",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "moduleNameMapper": {
    "^@react-pdf/renderer$": "<rootDir>/test/__mocks__/@react-pdf/renderer.ts"
  },
  "testTimeout": 120000,
  "globalSetup": "<rootDir>/test/e2e.global-setup.ts",
  "globalTeardown": "<rootDir>/test/e2e.global-teardown.ts",
  "setupFiles": ["<rootDir>/test/e2e.env.ts"]
}
