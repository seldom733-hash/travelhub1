// TravelHub v1

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ServiceType {
  TOUR
  HOTEL
  SANATORIUM
  FLIGHT
  TRAIN
  EXCURSION
  GUIDE
  TRANSFER
  PHOTOGRAPHER
}

enum UserRole {
  BUYER
  PARTNER
  ADMIN
  SALES_MANAGER
  OPERATOR
  DIRECTOR
  FINANCE
  MARKETER
  ANALYST
  MODERATOR
}

/// Жизненный цикл бронирования (Baseline §0.5, канонический): NEW →
/// PREPARING_REQUEST → SENT_TO_SUPPLIER → AWAITING_CONFIRMATION → CONFIRMED →
/// IN_SERVICE → COMPLETED. Ветви: NEEDS_CLARIFICATION, SUPPLIER_REJECTED,
/// CHANGE_REQUESTED, CANCELLATION_REQUESTED, CANCELLED, PROBLEM.
enum BookingStatus {
  NEW
  PREPARING_REQUEST
  SENT_TO_SUPPLIER
  AWAITING_CONFIRMATION
  CONFIRMED
  IN_SERVICE
  COMPLETED
  NEEDS_CLARIFICATION
  SUPPLIER_REJECTED
  CHANGE_REQUESTED
  CANCELLATION_REQUESTED
  CANCELLED
  PROBLEM
}

/// Жизненный цикл услуги (Гл. 4.12): Черновик → Заполнение → Проверка →
/// Согласование → Публикация → Активная продажа → Обновление → Приостановка →
/// Архив. READY = «готова к публикации», REVIEW = «на согласовании».
enum ServiceStatus {
  DRAFT
  REVIEW
  READY
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

/// Жизненный цикл заказа (Baseline §0.4, канонический): NEW → IN_PROCESSING →
/// WAITING_FOR_DATA → READY_FOR_BOOKING → SENT_TO_BOOKING → PARTIALLY_FULFILLED →
/// FULFILLED → READY_TO_CLOSE → CLOSED. Ветви: CANCELLED, PROBLEM, SUSPENDED.
/// Приоритет заказа (Гл. 3.7, 3.8, 3.10): влияет на порядок в рабочих очередях.
enum OrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Финансовое состояние заказа (Baseline §0.6): оплата — отдельная от операционного
/// жизненного цикла характеристика, которой владеет Finance. UI локализует код,
/// backend хранит стабильный код.
enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum OrderStatus {
  NEW
  IN_PROCESSING
  WAITING_FOR_DATA
  READY_FOR_BOOKING
  SENT_TO_BOOKING
  PARTIALLY_FULFILLED
  FULFILLED
  READY_TO_CLOSE
  CLOSED
  CANCELLED
  PROBLEM
  SUSPENDED
}

/// Словарь доменных событий Order Center (Гл. 6 «Событийная модель»): события
/// записываются в outbox (OrderEvent) в той же транзакции, что и изменение
/// состояния, и публикуются подписчикам (Booking Center, уведомления, лента).
enum OrderEventType {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_READY_FOR_BOOKING
  ORDER_SENT_TO_BOOKING
  ORDER_FULFILLED
  ORDER_CLOSED
  ORDER_CANCELLED
  ORDER_PROBLEM
  ORDER_PAYMENT_RECEIVED
  ORDER_PAYMENT_REFUNDED
  /// Команда Booking Center (Baseline §9): создание Booking инициирует ТОЛЬКО
  /// BookingRequested. Публикуется при «Передать в Booking Center» из READY_FOR_BOOKING.
  BOOKING_REQUESTED
  BOOKING_CREATED
  BOOKING_STATUS_CHANGED
  BOOKING_SENT_TO_SUPPLIER
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_CHANGED
  BOOKING_CANCELLED
  /// Sales Center (Phase 2, Baseline §0.7): события предшествуют созданию Order,
  /// поэтому orderId у них опционален — привязка через correlationId (sale.code).
  QUOTE_ACCEPTED
  SALE_COMPLETED
  /// Команда Order Center: создание Order инициирует ТОЛЬКО OrderRequested.
  ORDER_REQUESTED
  /// Finance Center (Phase 2, Baseline §0.6): финансовые события, владелец — Finance.
  PAYMENT_CREATED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  REFUND_REQUESTED
  REFUND_COMPLETED
  INVOICE_ISSUED
}

/// Состояние события в outbox: PENDING — записано вместе с транзакцией, ещё не
/// доставлено; PUBLISHED — успешно обработано подписчиками; FAILED — ошибка
/// обработки (событие сохранено для повторной публикации).
enum OrderEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

model User {
  id           String    @id @default(cuid())
  /// Канонический ID (Baseline §0.8): USR-* для персонала, CUS-* для клиентов/партнёров.
  code         String?   @unique
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String?
  role         UserRole  @default(BUYER)
  companyName  String?
  phone        String?
  partnerType  String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  // Стартовое рабочее пространство Dashboard (Гл. 1.2, 1.44): по умолчанию
  // зависит от роли (см. roleDefaultWorkspace), пользователь может переопределить.
  defaultWorkspace String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  services     Service[] @relation("ServiceProvider")
  managedServices Service[] @relation("ServiceManager")
  reviews      Review[]
  bookings     Booking[]
  orders       Order[]
  serviceViews ServiceView[]
}

model Service {
  id           String      @id @default(cuid())
  /// Код услуги (Baseline §0.8): канонический ID PRD-00000001 (формируется системой, неизменяем)
  code         String      @unique
  type         ServiceType
  title        String
  slug         String      @unique
  description  String?
  shortDesc    String?
  price        Float
  currency     String      @default("USD")
  discountPrice Float?
  city         String?
  country      String?
  countryCode  String?
  latitude     Float?
  longitude    Float?
  rating       Float       @default(0)
  reviewCount  Int         @default(0)
  images       String      @default("[]")
  duration     String?
  maxGuests    Int?
  languages    String?
  isActive     Boolean     @default(true)
  isFeatured   Boolean     @default(false)
  isHot        Boolean     @default(false)
  hotDiscount  Int?        @default(0)
  providerId   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // ── Жизненный цикл услуги (Гл. 4.12) ──
  /// Текущий статус жизненного цикла (Черновик…Архив)
  status       ServiceStatus @default(DRAFT)
  /// Номер текущей редакции карточки (Гл. 4.12 «Текущая версия»)
  version      Int          @default(1)
  /// Ответственный сотрудник (менеджер каталога, Гл. 4.3/4.5)
  managerId    String?
  /// Дата публикации (Гл. 4.10)
  publishedAt  DateTime?
  /// Классификация: подкатегория, напр. «Пляжный», «Семейный» (Гл. 4.5)
  category     String?
  /// Теги: JSON-массив строк (Гл. 4.8)
  tags         String?

  // ── Доступность и квоты (Гл. 4.7) ──
  /// Период продажи
  salesStart   DateTime?
  salesEnd     DateTime?
  /// Период оказания услуги
  serviceStart DateTime?
  serviceEnd   DateTime?
  /// Общая квота, забронировано, в резерве (доступно = общая − забронировано − резерв)
  quotaTotal   Int?         @default(0)
  quotaBooked  Int?         @default(0)
  quotaReserved Int?        @default(0)

  // ── SEO и публикация (Гл. 4.8/4.10) ──
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  /// Каналы распространения: JSON-массив, напр. ["Сайт","Мобильное приложение"] (Гл. 4.10)
  channels       String?
  /// Связанные услуги: JSON-массив id (Гл. 4.9)
  relatedIds     String?

  provider     User? @relation("ServiceProvider", fields: [providerId], references: [id])
  manager      User? @relation("ServiceManager", fields: [managerId], references: [id])
  reviews      Review[]
  bookings     Booking[]
  items        OrderItem[]
  quoteItems   QuoteItem[]
  serviceViews ServiceView[]
  history      ServiceHistory[]

  @@index([type, isActive])
  @@index([countryCode])
  @@index([status])
  @@index([managerId])
}

/// Журнал изменений и версий карточки услуги (Гл. 4.12): каждая сохранённая
/// редакция фиксируется с номером версии, автором и перечнем изменённых разделов.
/// Используется для «Истории изменений», «Сравнения версий» и «Восстановления».
/// action: created | update | publish | unpublish | suspend | archive | restore | price
model ServiceHistory {
  id        String   @id @default(cuid())
  serviceId String
  version   Int
  action    String
  from      String?  // предыдущий статус (для переходов)
  to        String?  // новый статус
  fields    String?  // JSON: изменённые поля (для action = update)
  actorId   String?
  actorName String
  comment   String?
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([createdAt])
}

model Booking {
  id          String        @id @default(cuid())
  /// Канонический ID бронирования (Baseline §0.8): BKG-00000001
  code        String        @unique
  userId      String
  serviceId   String
  status      BookingStatus @default(NEW)
  amount      Float
  serviceDate DateTime
  /// Версия для optimistic locking (Baseline §13): инкрементируется при каждом изменении.
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  history BookingHistory[]
  messages BookingMessage[]
  passengers Passenger[]
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([serviceId])
  @@index([status])
  @@index([createdAt])
  @@index([orderId])
}

/// Пассажир конкретного Booking (Baseline §4): создаётся Booking Center на
/// основании подтверждённых OrderTraveler данных. Passenger НЕ заменяет
/// OrderTraveler — это разные сущности, владельцы разные.
model Passenger {
  id             String   @id @default(cuid())
  bookingId      String
  firstName      String
  lastName       String
  birthDate      DateTime?
  citizenship    String?
  gender         String?
  passportNumber String?
  passportExpiry DateTime?
  createdAt      DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

/// Позиция состава заказа (Baseline §3): Order владеет OrderItem — услуга,
/// количество и цена, зафиксированные на момент формирования заказа.
/// Booking создаётся позже (из OrderItem) событием BookingRequested.
model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  serviceId   String
  title       String
  type        ServiceType
  quantity    Int         @default(1)
  price       Float
  currency    String      @default("USD")
  amount      Float
  serviceDate DateTime?
  createdAt   DateTime    @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([serviceId])
}

/// Участник заказа (Baseline §4): Order хранит туристов ДО Booking; на их
/// основе Booking Center создаёт Passenger. dataCompleteness: complete | incomplete
/// — готовность данных к бронированию (паспортные поля).
model OrderTraveler {
  id               String   @id @default(cuid())
  orderId          String
  customerId       String?
  firstName        String
  lastName         String
  birthDate        DateTime?
  citizenship      String?
  gender           String?
  passportNumber   String?
  passportExpiry   DateTime?
  /// complete | incomplete
  dataCompleteness String   @default("incomplete")
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}


/// Заказ — центральная бизнес-сущность платформы (Гл. 6): объединяет клиента,
/// одну или несколько услуг (через бронирования), платежи, документы, партнёров,
/// менеджеров и историю взаимодействий.
model Order {
  id          String        @id @default(cuid())
  /// Канонический внутренний ID (Baseline §0.8): ORD-00000001
  code        String        @unique
  /// Пользовательский номер заказа (Baseline §0.8): TH-YYYY-######
  orderNumber String        @unique
  userId      String
  status      OrderStatus   @default(NEW)
  /// Финансовое состояние (Baseline §0.6): оплата отделена от жизненного цикла.
  paymentStatus OrderPaymentStatus @default(UNPAID)
  priority    OrderPriority @default(MEDIUM)
  currency    String        @default("USD")
  amount      Float
  paidAmount  Float       @default(0)
  serviceDate DateTime?
  source      String      @default("Сайт")
  /// Версия для optimistic locking (Baseline §13): инкрементируется при каждом изменении.
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
  items    OrderItem[]
  travelers OrderTraveler[]
  history  OrderHistory[]
  messages OrderMessage[]
  automationLogs AutomationLog[]
  exceptionLogs  ExceptionLog[]
  events   OrderEvent[]
  payments Payment[]
  refunds  Refund[]
  invoices Invoice[]
  commissions Commission[]
  /// Сделка, породившая заказ (Phase 2, Sales Center): read-only для Sales.
  sale     Sale?   @relation("SaleOrder")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([serviceDate])
}

/// Outbox доменных событий (Гл. 6, паттерн transactional outbox): событие пишется
/// атомарно с изменением бизнес-сущности, затем публикуется в event bus.
/// payload — JSON с контекстом (from/to, суммы, имена и т.п.).
/// correlationId — сквозной ID бизнес-процесса (Order.code либо Sale.code);
/// causationId — ID события-родителя. orderId опционален: события Sales Center
/// (QUOTE_ACCEPTED, SALE_COMPLETED, ORDER_REQUESTED) предшествуют созданию Order.
model OrderEvent {
  id            String          @id @default(cuid())
  orderId       String?
  type          OrderEventType
  payload       Json?
  status        OrderEventStatus @default(PENDING)
  error         String?
  correlationId String?
  causationId   String?
  createdAt     DateTime        @default(now())
  publishedAt   DateTime?

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([correlationId])
}

/// Сообщение переписки менеджера и клиента по заказу (вкладка «Коммуникации», Гл. 6.9).
/// senderRole: manager | client | system
model OrderMessage {
  id         String   @id @default(cuid())
  orderId    String
  senderId   String?
  senderName String
  senderRole String
  text       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([senderRole, isRead])
  @@index([createdAt])
}

/// Журнал изменений заказа (вкладка «История изменений», Гл. 6.9).
/// action: created | confirm | pay | complete | cancel | refund | archive | update
model OrderHistory {
  id        String   @id @default(cuid())
  orderId   String
  action    String
  from      String? // предыдущий статус (для переходов)
  to        String? // новый статус (для переходов)
  fields    String? // JSON: изменённые поля (для action = update)
  actorId   String?
  actorName String
  comment   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

/// Сообщение переписки менеджера и клиента (вкладка «Переписка», Гл. 5.9).
/// senderRole: manager | client | system
/// isRead: прочитано ли сообщение (непрочитанные system/manager помечают переписку
/// как требующую внимания — бейдж на вкладке и в таблице).
model BookingMessage {
  id         String   @id @default(cuid())
  bookingId  String
  senderId   String?
  senderName String
  senderRole String
  text       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([senderRole, isRead])
  @@index([createdAt])
}

/// Журнал изменений бронирования (вкладка «История» в карточке, Гл. 5.9).
/// action: created | confirm | pay | complete | cancel | update
model BookingHistory {
  id        String   @id @default(cuid())
  bookingId String
  action    String
  from      String? // предыдущий статус (для переходов)
  to        String? // новый статус (для переходов)
  fields    String? // JSON: изменённые поля (для action = update)
  actorId   String?
  actorName String
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
}

model ServiceView {
  id        String   @id @default(cuid())
  userId    String
  serviceId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serviceId])
  @@index([viewedAt])
}

model Review {
  id        String   @id @default(cuid())
  serviceId String
  userId    String
  rating    Int
  text      String?
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([serviceId])
}

/// Журнал автоматических операций (Гл. 3.16 «Мониторинг»): персистентные записи
/// SLA-действий из карточки заказа (повышение приоритета, эскалация, уведомление
/// руководителя). Дополняет детерминированные события Business Event Engine.
/// result: success | error | skipped
model AutomationLog {
  id          String   @id @default(cuid())
  orderId     String?
  event       String
  action      String
  result      String   @default("success")
  durationMs  Int      @default(0)
  source      String   @default("Business Event Engine")
  actorName   String?
  createdAt   DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}

/// Реестр исключительных ситуаций (Гл. 3.17): персистентные записи эскалаций
/// из карточки заказа. criticality: low | medium | high | critical,
/// status: new | working | resolved | closed.
model ExceptionLog {
  id           String   @id @default(cuid())
  orderId      String?
  type         String
  category     String
  criticality  String   @default("critical")
  orderNumber  String?
  manager      String?
  status       String   @default("working")
  description  String
  aiSuggestion String?
  actorName    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order   Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  history ExceptionLogHistory[]

  @@index([orderId])
  @@index([createdAt])
  @@index([status])
}

/// Журнал обработки исключения (Гл. 3.17): каждая смена статуса записывает
/// историю — кто, когда и какое действие выполнил (взял в работу, решил, закрыл).
/// action: take | resolve | close | reopen
model ExceptionLogHistory {
  id        String   @id @default(cuid())
  exceptionLogId String
  action    String
  from      String?
  to        String?
  comment   String?
  actorId   String?
  actorName String
  createdAt DateTime @default(now())

  exceptionLog ExceptionLog @relation(fields: [exceptionLogId], references: [id], onDelete: Cascade)

  @@index([exceptionLogId])
  @@index([createdAt])
}

/// Журнал аудита (Гл. 3.18): централизованная регистрация всех значимых действий
/// пользователей, автоматических процессов и внешних интеграций. Неизменяемый
/// журнал — записи не редактируются и не удаляются обычными пользователями.
/// Категории: Пользовательские действия | Финансовые операции | Документооборот |
/// Безопасность | Интеграции | AI-события. action: login | logout | create |
/// update | status | payment | refund | document | bulk | api | ai | security.
model AuditLog {
  id           String   @id @default(cuid())
  /// Уникальный номер события (например AUD-000001)
  eventId      String   @unique
  /// Исполнитель (пользователь, система, интеграция, AI)
  userId       String?
  actorName    String
  actorRole    String?
  department   String?
  /// Категория события (см. комментарий модели)
  category     String
  /// Тип действия
  action       String
  /// Объект: Заказ, Документ, Платёж, Пользователь, Услуга, Бронирование, Исключение
  objectType   String?
  objectId     String?
  /// Номер объекта: ORD-1001, SVC-0001, INV-0001…
  objectNumber String?
  /// JSON: предыдущие значения изменённых полей
  fromData     String?
  /// JSON: новые значения изменённых полей
  toData       String?
  /// Комментарий / причина изменения
  comment      String?
  /// Источник: Web, API, Mobile, AI, Integration, System
  source       String   @default("Web")
  /// IP-адрес источника (для пользовательских действий)
  ip           String?
  /// User Agent клиентского приложения
  userAgent    String?
  /// Критичность: info | warning | error | critical
  criticality  String   @default("info")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@index([action])
  @@index([userId])
  @@index([objectType, objectId])
}

/// Шаблон Dashboard (Гл. 1.36): администратор создаёт макет для роли,
/// каждый новый сотрудник этой роли получает его автоматически как стартовый.
/// layout — JSON LayoutState (hidden/order/stars/sizes) из dashboard-widgets.ts.
model DashboardTemplate {
  id        String   @id @default(cuid())
  /// Роль, для которой предназначен шаблон (ADMIN, SALES_MANAGER, OPERATOR…)
  role      String
  /// Название шаблона, например «Dashboard менеджера»
  name      String
  /// JSON-макет (LayoutState) либо 'workspace:<key>' для шаблона пространства
  layout    String
  /// Кто создал шаблон
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, name])
  @@index([role])
}

model Country {
  code      String   @id
  nameRu    String
  nameEn    String
  createdAt DateTime @default(now())

  cities City[]
}

model City {
  id          String   @id @default(cuid())
  nameRu      String
  nameEn      String
  countryCode String
  createdAt   DateTime @default(now())

  country   Country @relation(fields: [countryCode], references: [code])

  @@unique([countryCode, nameRu])
  @@index([countryCode])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 2 — Sales Center (Baseline §0.7): Lead → Opportunity → Quote → Sale
// Владелец домена: Sales. Customer reference — CRM (User с кодом CUS-*).
// Канонические ID: LED-*, OPP-*, QTE-*, SAL-* (Baseline §0.8).
// ═══════════════════════════════════════════════════════════════════════════════

/// Лид (Phase 2): потенциальный клиент до квалификации.
/// status: NEW | QUALIFIED | DISQUALIFIED | CONVERTED | LOST
/// qualification: cold | warm | hot
model Lead {
  id            String    @id @default(cuid())
  /// Канонический ID лида (Baseline §0.8): LED-00000001
  code          String    @unique
  source        String    @default("Сайт")
  /// Ссылка на клиента CRM (CUS-*); может быть null до создания клиента
  customerId    String?
  customerName  String
  contactEmail  String?
  contactPhone  String?
  /// Интерес (услуги/направления)
  interest      String?
  /// Ответственный менеджер (владелец)
  ownerId       String?
  ownerName     String?
  qualification String    @default("cold")
  status        String    @default("NEW")
  nextAction    String?
  nextActionAt  DateTime?
  /// Дедлайн SLA обработки лида
  slaDueAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  history LeadHistory[]

  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
}

/// Журнал изменений лида (Phase 2): квалификация, конвертация, потеря.
model LeadHistory {
  id        String   @id @default(cuid())
  leadId    String
  action    String
  from      String?
  to        String?
  comment   String?
  actorId   String?
  actorName String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

/// Возможность (Phase 2): квалифицированная сделка.
/// stage: QUALIFICATION | NEED_ANALYSIS | QUOTE | NEGOTIATION | WON | LOST
model Opportunity {
  id                String    @id @default(cuid())
  /// Канонический ID возможности (Baseline §0.8): OPP-00000001
  code              String    @unique
  customerId        String
  customerName      String
  contactEmail      String?
  contactPhone      String?
  ownerId           String?
  ownerName         String?
  /// Потребность/контекст
  need              String?
  /// Ссылки на продукты (JSON-массив service id)
  productsRef       String    @default("[]")
  budget            Float?
  currency          String    @default("USD")
  expectedCloseDate DateTime?
  /// Вероятность закрытия, %
  probability       Int       @default(50)
  stage             String    @default("QUALIFICATION")
  nextAction        String?
  nextActionAt      DateTime?
  risks             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  quotes Quote[]

  @@index([stage])
  @@index([ownerId])
  @@index([customerId])
}

/// Коммерческое предложение (Phase 2): собственные коммерческие условия + ссылки
/// на Product (Catalog ownership не копируется). Версии: version инкрементируется
/// при каждой новой редакции; items — снимок состава предложения.
/// status: DRAFT | SENT | ACCEPTED | REJECTED
model Quote {
  id             String   @id @default(cuid())
  /// Канонический ID предложения (Baseline §0.8): QTE-00000001
  code           String   @unique
  opportunityId  String
  customerId     String
  customerName   String
  currency       String   @default("USD")
  /// Номер версии предложения (Phase 2, §3 Quote: versions)
  version        Int      @default(1)
  discount       Float    @default(0)
  fees           Float    @default(0)
  validUntil     DateTime?
  status         String   @default("DRAFT")
  /// Согласование (approval): pending | approved | rejected
  approval       String   @default("pending")
  approvedBy     String?
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  items       QuoteItem[]
  sale        Sale?

  @@index([opportunityId])
  @@index([status])
}

/// Позиция коммерческого предложения (Phase 2): снимок Product + количество и цена.
model QuoteItem {
  id        String      @id @default(cuid())
  quoteId   String
  serviceId String
  title     String
  type      ServiceType
  quantity  Int         @default(1)
  price     Float
  amount    Float
  createdAt DateTime    @default(now())

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([quoteId])
}

/// Сделка (Phase 2): завершённая коммерческая сделка. После SaleCompleted
/// публикуется OrderRequested — Order Center создаёт Order (см. events.ts).
/// status: WON | LOST | CANCELLED
model Sale {
  id             String    @id @default(cuid())
  /// Канонический ID сделки (Baseline §0.8): SAL-00000001
  code           String    @unique
  quoteId        String    @unique
  customerId     String
  customerName   String
  amount         Float
  currency       String    @default("USD")
  status         String    @default("WON")
  closedAt       DateTime?
  /// Связанный заказ (Order Center): Sales видит его read-only (Baseline §5)
  orderId        String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  /// Связанный заказ (Order Center): Sales видит его read-only
  order Order? @relation("SaleOrder", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 2 — Finance Center (Baseline §0.6): владелец — Finance.
// Канонические ID: PAY-*, RFD-*, INV-*, CMS-*, CUR-*, FXR-*, TAX-*, TXR-*.
// Settings НЕ владеет Currency/Tax — только Finance.
// ═══════════════════════════════════════════════════════════════════════════════

/// Платёж (Phase 2): создаётся Finance на основании Order/Sale триггера.
/// status: CREATED | RECEIVED | FAILED
model Payment {
  id         String   @id @default(cuid())
  /// Канонический ID платежа (Baseline §0.8): PAY-00000001
  code       String   @unique
  orderId    String?
  saleId     String?
  customerId String?
  amount     Float
  currency   String   @default("USD")
  method     String   @default("Банковский перевод")
  status     String   @default("CREATED")
  receivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

/// Возврат (Phase 2): RefundRequested → RefundCompleted.
/// status: REQUESTED | COMPLETED | FAILED
model Refund {
  id         String   @id @default(cuid())
  /// Канонический ID возврата (Baseline §0.8): RFD-00000001
  code       String   @unique
  orderId    String?
  paymentId  String?
  amount     Float
  currency   String   @default("USD")
  reason     String?
  status     String   @default("REQUESTED")
  completedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
}

/// Счёт (Phase 2): InvoiceIssued → документ. status: DRAFT | ISSUED | PAID | VOID
model Invoice {
  id         String   @id @default(cuid())
  /// Канонический ID счёта (Baseline §0.8): INV-00000001
  code       String   @unique
  orderId    String?
  saleId     String?
  customerId String?
  amount     Float
  currency   String   @default("USD")
  status     String   @default("DRAFT")
  issuedAt   DateTime?
  dueAt      DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

/// Комиссия партнёра/поставщика (Phase 2). status: PENDING | PAID
model Commission {
  id        String   @id @default(cuid())
  /// Канонический ID комиссии (Baseline §0.8): CMS-00000001
  code      String   @unique
  orderId   String?
  partnerId String?
  amount    Float
  currency  String   @default("USD")
  rate      Float    @default(0)
  status    String   @default("PENDING")
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
}

/// Валюта (Phase 2): справочник владеет ТОЛЬКО Finance. isBase — базовая валюта.
model Currency {
  id        String   @id @default(cuid())
  /// Канонический ID валюты (Baseline §0.8): CUR-00000001
  code      String   @unique
  name      String
  symbol    String
  isBase    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  ratesFrom ExchangeRate[] @relation("RateFrom")
  ratesTo   ExchangeRate[] @relation("RateTo")
}

/// Валютный курс (Phase 2): исторический курс from → to на дату.
model ExchangeRate {
  id        String   @id @default(cuid())
  /// Канонический ID курса (Baseline §0.8): FXR-00000001
  code      String   @unique
  fromCode  String
  toCode    String
  rate      Float
  date      DateTime
  createdAt DateTime @default(now())

  from Currency @relation("RateFrom", fields: [fromCode], references: [code])
  to   Currency @relation("RateTo", fields: [toCode], references: [code])

  @@unique([fromCode, toCode, date])
  @@index([date])
}

/// Налог (Phase 2): ставка налога. владелец — Finance, не Settings.
model Tax {
  id        String   @id @default(cuid())
  /// Канонический ID налога (Baseline §0.8): TAX-00000001
  code      String   @unique
  name      String
  rate      Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  rules TaxRule[]
}

/// Правило применения налога (Phase 2): по стране/типу услуги.
model TaxRule {
  id        String  @id @default(cuid())
  /// Канонический ID правила (Baseline §0.8): TXR-00000001
  code      String  @unique
  taxId     String
  country   String?
  serviceType String?
  rateOverride Float?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  tax Tax @relation(fields: [taxId], references: [id], onDelete: Cascade)

  @@index([taxId])
  @@index([country])
}
